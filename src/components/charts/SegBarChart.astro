---
// Poziome paski segmentowe z animowanym wypełnieniem i licznikiem wartości.
// Segmenty rysowane z malejącym kryciem (1 / .72 / .45), wiersz `win` dostaje akcentowe tło.
interface Row {
  label: string;
  color: string;      // dowolny CSS color, np. var(--bm-keil)
  segments: number[]; // szerokości w % (suma ≤ 100)
  count: number;      // wartość docelowa licznika
  suffix?: string;    // np. ' ms', ' tys. zł' — nadpisuje suffix wykresu
  win?: boolean;
}
interface Props {
  rows: Row[];
  suffix?: string;  // domyślny suffix liczników
  legend?: string;
  light?: boolean;  // jasne tło (domyślnie wariant na ciemną sekcję)
}
const { rows, suffix = ' ms', legend, light = false } = Astro.props;
const OPACITY = [1, 0.72, 0.45];
---
<div class:list={['sb', { 'sb--light': light }]} data-segbars>
  {rows.map((r) => (
    <div class:list={['sb__row', { 'sb__row--win': r.win }]}>
      <span class="sb__lbl">
        <i class="sb__swatch" style={`background:${r.color}`}></i>
        {r.win ? <strong>{r.label}</strong> : r.label}
      </span>
      <span class="sb__track">
        {r.segments.map((w, i) => (
          <span class="sb__seg" style={`--w:${w}%;background:${r.color};opacity:${OPACITY[i] ?? 0.3}`}></span>
        ))}
      </span>
      <span class="sb__val" data-count={r.count} data-suffix={r.suffix ?? suffix}>
        {r.win ? <strong>0</strong> : '0'}
      </span>
    </div>
  ))}
  {legend && <p class="sb__legend">{legend}</p>}
</div>

<style>
  .sb { display: grid; gap: 2px; }
  .sb__row { display: grid; grid-template-columns: minmax(130px, 190px) 1fr minmax(84px, auto); gap: var(--space-md, 1rem); align-items: center; padding: .55rem .9rem; border-radius: var(--radius-btn, 8px); }
  .sb__row--win { background: color-mix(in oklch, var(--color-accent) 10%, transparent); outline: 1px solid color-mix(in oklch, var(--color-accent) 35%, transparent); }
  .sb__lbl { display: flex; align-items: center; gap: .55rem; font-size: var(--text-s); color: var(--color-text-inv, #eee); white-space: nowrap; }
  .sb__swatch { flex: none; width: 10px; height: 10px; border-radius: 3px; display: inline-block; }
  .sb__track { display: flex; height: 20px; background: color-mix(in oklch, currentColor 10%, transparent); border-radius: 5px; overflow: hidden; gap: 2px; }
  .sb__seg { height: 100%; width: 0; transition: width 1.1s cubic-bezier(.22, .61, .36, 1); }
  .sb.is-in .sb__seg { width: var(--w); }
  .sb__val { font-variant-numeric: tabular-nums; font-weight: 600; font-size: var(--text-s); color: var(--color-text-inv, #eee); text-align: right; white-space: nowrap; }
  .sb__legend { margin: var(--space-sm, .75rem) .9rem 0; font-size: var(--text-caption); color: var(--color-text-inv-3, #99a); }
  .sb--light .sb__lbl, .sb--light .sb__val { color: var(--color-text, #1c1e22); }
  .sb--light .sb__legend { color: var(--color-text-2, #667); }
  @media (prefers-reduced-motion: reduce) { .sb__seg { transition: none; } .sb .sb__seg { width: var(--w); } }
</style>

<script>
  const runCount = (el: Element) => {
    const target = +(el as HTMLElement).dataset.count!;
    const suffix = (el as HTMLElement).dataset.suffix || '';
    const strong = el.querySelector('strong');
    const t0 = performance.now();
    const tick = () => {
      const p = Math.min(1, (performance.now() - t0) / 1100);
      const v = Math.round(target * (1 - (1 - p) * (1 - p)));
      (strong || el).textContent = `${v}${suffix}`;
      if (p < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  };
  document.querySelectorAll('[data-segbars]').forEach((bars) => {
    new IntersectionObserver((entries, obs) => {
      if (!entries.some((e) => e.isIntersecting)) return;
      bars.classList.add('is-in');
      bars.querySelectorAll('.sb__val').forEach(runCount);
      obs.disconnect();
    }, { threshold: 0.35 }).observe(bars);
  });
</script>
