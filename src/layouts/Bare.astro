---
// Wspólna powłoka samodzielnych stron (login/reset/zapis/qr) — bez nav strefy i stopki.
// Style strony dochodzą przez importy CSS w frontmatterze strony; <style> stron Astro
// hoistuje do <head> automatycznie. Fonty self-hosted (fonts.css + preload woff2).
import '../styles/fonts.css';
import HeadAssets from '../components/HeadAssets.astro';
const { title, viewport = 'width=device-width, initial-scale=1' } = Astro.props;
---
<!doctype html>
<html lang="pl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content={viewport} />
  <title>{title}</title>
  <meta name="robots" content="noindex, nofollow" />
  <HeadAssets />
  <slot name="head" />
</head>
<body class="strefa-body">
  <slot />
</body>
</html>
