---
// Wspólna powłoka samodzielnych stron (login/reset/zapis/qr) — bez nav strefy i stopki.
// Style strony dochodzą przez importy CSS w frontmatterze strony; <style> stron Astro
// hoistuje do <head> automatycznie. Fonty self-hosted (fonts.css + preload woff2).
import '../styles/fonts.css';
const { title, viewport = 'width=device-width, initial-scale=1' } = Astro.props;
---
<!doctype html>
<html lang="pl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content={viewport} />
  <title>{title}</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="preload" as="font" type="font/woff2" href="/fonts/albert-sans-v4-latin.woff2" crossorigin />
  <link rel="preload" as="font" type="font/woff2" href="/fonts/albert-sans-v4-latin-ext.woff2" crossorigin />
  <link rel="preload" as="font" type="font/woff2" href="/fonts/space-grotesk-v22-latin.woff2" crossorigin />
  <link rel="preload" as="font" type="font/woff2" href="/fonts/space-grotesk-v22-latin-ext.woff2" crossorigin />
  <link rel="icon" type="image/svg+xml" href="/img/favicon.svg" />
  <slot name="head" />
</head>
<body class="strefa-body">
  <slot />
</body>
</html>
