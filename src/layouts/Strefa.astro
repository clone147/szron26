---
// Layout strefy zamkniętej SZRON — samodzielna powłoka aplikacji (bez marketingowego nav/stopki).
// Każda strona używająca tego layoutu jest chroniona: skrypt sprawdza sesję i allowlistę,
// niezalogowanych przekierowuje na /strefa/login.
import '../styles/fonts.css';
import '../styles/main.css';
import '../styles/strefa.css';
import HeadAssets from '../components/HeadAssets.astro';
const { title = 'Strefa SZRON', active = '' } = Astro.props;
---
<!doctype html>
<html lang="pl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} — Strefa SZRON</title>
  <meta name="robots" content="noindex, nofollow" />
  <HeadAssets />
</head>
<body class="strefa-body">
  <script is:inline>
    // motyw przed pierwszym renderem — bez błysku ciemnego tła
    (function () {
      try {
        if (localStorage.getItem('strefa-theme') === 'light') document.body.dataset.theme = 'light';
      } catch (e) {}
    })();
  </script>
  <div class="strefa-shell" data-strefa-guarded hidden>
    <header class="strefa-top">
      <div class="strefa-top__inner">
        <a class="logo" href="/" aria-label="SZRON — strona główna">
          <img id="strefa-logo" src="/img/logo-dark.svg" alt="" width="96" height="24" />
        </a>
        <nav class="strefa-top__nav" aria-label="Nawigacja strefy">
          <a href="/strefa" class="strefa-top__tag">Strefa</a>
          <a href="/strefa" class={active === 'pulpit' ? 'is-active' : ''}>Pulpit</a>
          <a href="/strefa/plan" class={active === 'plan' ? 'is-active' : ''}>Plan</a>
          <a href="/strefa/szkolenia" class={active === 'szkolenia' ? 'is-active' : ''}>Szkolenia</a>
          <a href="/strefa/programisci" class={active === 'programisci' ? 'is-active' : ''}>Ludzie</a>
          <a href="/strefa/diagramy" class={active === 'diagramy' ? 'is-active' : ''}>Diagramy</a>
          <a href="/strefa/rezyserka" class={active === 'rezyserka' ? 'is-active' : ''}>Reżyserka</a>
          <a href="/strefa/sygnaly" class={active === 'sygnaly' ? 'is-active' : ''}>Sygnały</a>
          <a href="/strefa/decydenci" class={active === 'decydenci' ? 'is-active' : ''}>Decydenci</a>
          <a href="/strefa/x" class={active === 'x' ? 'is-active' : ''}>X Growth</a>
        </nav>
        <div class="strefa-top__user">
          <span class="strefa-top__email" id="strefa-user" aria-live="polite"></span>
          <button type="button" class="strefa-btn strefa-btn--ghost" id="strefa-theme" aria-label="Przełącz motyw jasny/ciemny" title="Motyw jasny/ciemny">
            <svg id="strefa-theme-moon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z"/></svg>
            <svg id="strefa-theme-sun" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" hidden><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          </button>
          <button type="button" class="strefa-btn strefa-btn--ghost" id="strefa-logout">Wyloguj</button>
        </div>
      </div>
    </header>
    <main class="strefa-main" data-page={active}>
      <slot />
    </main>
  </div>

  <div class="strefa-boot" id="strefa-boot">
    <div class="strefa-boot__spinner" aria-hidden="true"></div>
    <p>Sprawdzam dostęp…</p>
  </div>

  <script>
    import { requireAuth, signOut } from '../lib/supabase.js';
    (async () => {
      const user = await requireAuth('/strefa/login');
      if (!user) return; // requireAuth przekierował
      const shell = document.querySelector('[data-strefa-guarded]');
      const boot = document.getElementById('strefa-boot');
      const emailEl = document.getElementById('strefa-user');
      if (emailEl) emailEl.textContent = user.email || '';
      if (boot) boot.remove();
      if (shell) shell.hidden = false;
      // przełącznik motywu jasny/ciemny (zapamiętywany w localStorage)
      const themeBtn = document.getElementById('strefa-theme');
      const syncTheme = () => {
        const light = document.body.dataset.theme === 'light';
        document.getElementById('strefa-theme-moon').hidden = light;
        document.getElementById('strefa-theme-sun').hidden = !light;
        const logo = document.getElementById('strefa-logo');
        if (logo) logo.src = light ? '/img/logo.svg' : '/img/logo-dark.svg';
      };
      syncTheme();
      themeBtn?.addEventListener('click', () => {
        const light = document.body.dataset.theme !== 'light';
        if (light) document.body.dataset.theme = 'light';
        else delete document.body.dataset.theme;
        try { localStorage.setItem('strefa-theme', light ? 'light' : 'dark'); } catch (e) {}
        syncTheme();
      });
      const logout = document.getElementById('strefa-logout');
      logout?.addEventListener('click', async () => {
        logout.disabled = true;
        await signOut();
        window.location.replace('/');
      });
    })();
  </script>
</body>
</html>
