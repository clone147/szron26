---
import '../styles/fonts.css';
import '../styles/main.css';
import { createHash } from 'node:crypto';
import { readFileSync } from 'node:fs';
import HeadAssets from '../components/HeadAssets.astro';

// Cache-busting: /js/* ma na Netlify roczny immutable cache, a main.js nie ma
// hasha w nazwie — wersjonujemy query paramem liczonym z treści przy buildzie.
const mainJsHash = createHash('md5')
  .update(readFileSync(new URL('../../public/js/main.js', import.meta.url)))
  .digest('hex')
  .slice(0, 10);

const {
  title = 'Wdrożenie AI w zespole programistów — 2–4× szybciej | SZRON',
  description = 'Wdrażamy AI i programowanie agentowe (Claude Code, agenci, MCP) w zespołach IT dużych firm — na Waszym kodzie. Szkolenie, agenci w codziennej pracy i pilot modernizacji w dwa kwartały. Efekt mierzony metrykami DORA.',
  ogDescription = description,
  ogImage = '/img/og-cover.webp',
  schema = [],
} = Astro.props;

// Kanoniczny URL + absolutny og:image (względem domeny z astro.config `site`)
const site = Astro.site ?? new URL('https://szron.tech');
const canonical = new URL(Astro.url.pathname, site).href;
const ogImageAbs = new URL(ogImage, site).href;

const orgSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['Organization', 'ProfessionalService'],
      '@id': new URL('/#org', site).href,
      name: 'SZRON',
      legalName: 'SZRON Tomek Wojciechowski',
      url: site.href,
      logo: new URL('/img/logo.svg', site).href,
      image: ogImageAbs,
      description: 'Transformacja zespołów IT i programowanie agentowe dla dużych firm.',
      email: 'tw@szron.tech',
      telephone: '+48505091200',
      priceRange: '$$',
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'ul. Legionistów 12/1/B',
        postalCode: '35-317',
        addressLocality: 'Rzeszów',
        addressCountry: 'PL',
      },
      areaServed: { '@type': 'Country', name: 'Polska' },
      hasMap: 'https://g.page/r/CVPGYD5OGvcNEBM',
      openingHoursSpecification: [
        {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
          opens: '07:00',
          closes: '17:00',
        },
      ],
      founder: [
        { '@type': 'Person', name: 'Tomek Wojciechowski' },
        { '@type': 'Person', name: 'Maciej Stopa' },
      ],
    },
    {
      '@type': 'WebSite',
      '@id': new URL('/#website', site).href,
      url: site.href,
      name: 'SZRON',
      inLanguage: 'pl-PL',
      publisher: { '@id': new URL('/#org', site).href },
    },
  ],
};
---
<!doctype html>
<html lang="pl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="SZRON" />
  <meta property="og:locale" content="pl_PL" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={ogDescription} />
  <meta property="og:image" content={ogImageAbs} />
  <meta property="og:url" content={canonical} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={ogDescription} />
  <meta name="twitter:image" content={ogImageAbs} />
  <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
  {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  <HeadAssets />
</head>
<body>
  <slot />
  <script src={`/js/main.js?v=${mainJsHash}`} defer></script>
</body>
</html>
