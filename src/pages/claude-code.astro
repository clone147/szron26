  <!-- CTA -->
  <CtaBand
    padTop={false}
    heading="Chcecie, żeby tak pracował cały Wasz zespół?"
    text="To szkolenie to materiał. Wdrożenie to dwa kwartały na Waszym kodzie — z pomiarem efektu w DEVLens. Audyt 90 minut wystarczy, żeby sprawdzić, czy ma to u Was sens."
  />
</Interior>
