---
import Interior from '../layouts/Interior.astro';
import SectHead from '../components/SectHead.astro';
import ProofStrip from '../components/ProofStrip.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import ShotGallery from '../components/ShotGallery.astro';

// FAQ — numeracja 01…NN generowana w <Faq />
const faq = [
  { q: 'Czy AI zastąpi moich programistów?', a: 'Nie. AI to narzędzie, które wzmacnia programistów, a nie ich zastępuje. Najlepsi devowie z AI są jeszcze lepsi. Słabi nadal będą słabi — AI nie da im umiejętności, których nie mają.' },
  { q: 'Jak długo trwa szkolenie zespołu?', a: 'Podstawowe szkolenie to 1–2 dni. Pełna augmentacja z transferem wiedzy zajmuje 1–3 miesiące, w zależności od wielkości zespołu.' },
  { q: 'Czy dane naszego kodu są bezpieczne?', a: 'Możemy pracować z lokalnymi modelami (LM Studio, Llama), które nie wysyłają kodu na zewnątrz. Dla enterprise oferujemy rozwiązania self-hosted.' },
  { q: 'Ile to kosztuje?', a: 'Szczegóły finansowe omawiamy indywidualnie podczas pierwszej rozmowy. Zaczynamy od 3-miesięcznego zobowiązania, w którym udowadniamy wartość na twardych danych.' },
];
---
<Interior
  title="AI dla programistów — 3x szybsze projekty IT | SZRON"
  description="Wdrożenie agentów AI (Opus, Sonnet) w zespołach dev: Claude Code, MCP Tools, Cursor, Copilot. Uczymy efektywnej pracy z agentami i mierzymy produktywność."
  eyebrow="Dla CTO i tech leadów · zobowiązanie kwartalne"
  heading="3x szybsze projekty IT."
  lead="Wasi programiści mogą kodować 55–80% szybciej. Uczymy ich korzystać z AI tak, żeby sami to kontynuowali — od analizy zespołu, przez dobór narzędzi i warsztaty, po pomiar produktywności przed i po."
  heroImage="/img/sub/transformacja-ai-dla-programistow-orchestrator.webp"
  heroAlt="Programista orkiestrujący rój agentów Claude Code — HUD z aktywnymi sub-agentami"
  ogImage="/img/og-tomek-orchestrator.webp"
>
  <!-- proof -->
  <ProofStrip items={[
    ['Agenci AI', 'Opus i Sonnet do kodu produkcyjnego'],
    ['Setup pod stack', 'Claude Code, MCP Tools, Cursor, Copilot'],
    ['Pomiar przed i po', 'konkretny ROI, nie obietnice'],
  ]} />

  <!-- 01 mierzalne korzyści -->
  <section class="sect" aria-labelledby="korzysci">
    <div class="container">
      <SectHead eyebrow="01 / Korzyści · Co realnie się zmienia" title="Mierzalne korzyści dla zespołu." id="korzysci" />
      <div class="grid-cards">
        <article class="card-tile rv">
          <p class="eyebrow">55–80%</p>
          <h3>Szybsze kodowanie</h3>
          <p>Według badań GitHub i naszych wdrożeń.</p>
        </article>
        <article class="card-tile rv" style="--rv-d:.08s">
          <p class="eyebrow">50%</p>
          <h3>Mniej bugów</h3>
          <p>Quality gates oparte na AI wyłapują błędy wcześniej.</p>
        </article>
        <article class="card-tile rv" style="--rv-d:.16s">
          <p class="eyebrow">3x</p>
          <h3>Szybszy onboarding</h3>
          <p>Nowi devowie produktywni od pierwszego dnia.</p>
        </article>
        <article class="card-tile rv" style="--rv-d:.24s">
          <p class="eyebrow">30%</p>
          <h3>Mniej context switching</h3>
          <p>AI pamięta kontekst projektu za Was.</p>
        </article>
      </div>
      <div class="prose rv" style="margin-top:var(--space-2xl)">
        <p>Jest jednak haczyk — badania adopcji z 2026 nazywają go paradoksem produktywności AI: 84% programistów używa AI, licencje kupili prawie wszyscy, a delivery stoi w miejscu. Czemu? Bo tylko 29% devów ufa temu, co AI wypluwa, i bez treningu oszczędność kończy się na 3,6 godziny tygodniowo. Pomaga dopiero zmiana sposobu pracy — licencja wpięta w stary proces daje stare wyniki. Przeprojektowujemy workflow zespołu — od definicji zadań po review — tak, żeby agenci robili robotę, a devowie ją prowadzili. Firmy, które to zrobiły, wyciągają ROI 2,5–3,5×, górny kwartyl 4–6×. Dokładnie od tego zaczynamy.</p>
      </div>
    </div>
  </section>

  <!-- 02 narzędzia (ciemna) -->
  <section class="sect sect--dark" aria-labelledby="narzedzia">
    <div class="container">
      <SectHead eyebrow="02 / Narzędzia · Co wdrażamy" title="Narzędzia dobrane do Waszego stacku i potrzeb zespołu." id="narzedzia" />
      <table class="results-table rv">
        <thead><tr><th scope="col">Narzędzie</th><th scope="col">Rola</th><th scope="col">Wzrost</th></tr></thead>
        <tbody>
          <tr><td>Claude Opus / Sonnet</td><td>Agenci AI do kodu produkcyjnego</td><td><strong>3x</strong></td></tr>
          <tr><td>Claude Code</td><td>Interfejs do uruchamiania agentów</td><td><strong>3x</strong></td></tr>
          <tr><td>MCP Tools</td><td>Integracje agentów z systemami</td><td><strong>2x</strong></td></tr>
          <tr><td>Cursor / Copilot</td><td>Narzędzia pomocnicze w IDE</td><td><strong>55–70%</strong></td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- 03 proces wdrożenia -->
  <section class="sect" aria-labelledby="proces">
    <div class="container">
      <SectHead eyebrow="03 / Proces · Jak wygląda wdrożenie" title="Cztery kroki: od analizy do pomiaru." id="proces" />
      <div class="steps">
        <article class="step rv"><p class="eyebrow">01 · Analiza</p><h3>Sprawdzamy, jak pracujecie</h3><p>Patrzymy, jakich narzędzi używa zespół i gdzie są bottlenecki.</p></article>
        <article class="step rv" style="--rv-d:.08s"><p class="eyebrow">02 · Dobór narzędzi</p><h3>Pod Wasz stack</h3><p>Rekomendujemy narzędzia AI dopasowane do Waszego stacku technologicznego.</p></article>
        <article class="step rv" style="--rv-d:.16s"><p class="eyebrow">03 · Szkolenie</p><h3>Praktyczne warsztaty</h3><p>Context Engineering i praca z agentami AI — na realnych zadaniach.</p></article>
        <article class="step rv" style="--rv-d:.24s"><p class="eyebrow">04 · Pomiar</p><h3>Produktywność przed i po</h3><p>Mierzymy efekty i pokazujemy konkretny ROI.</p></article>
      </div>
      <ShotGallery cols={2} items={[
        { src: '/img/devlens/05-akceleracja.webp', alt: 'Raport wzrostu wydajności zespołu: średni wzrost tempa pracy +266,6%, analiza porównawcza przed/po dacie granicznej', caption: 'Pomiar z realnego wdrożenia — średni wzrost tempa pracy zespołu +266% po dacie wdrożenia AI.' },
        { src: '/img/devlens/04-porownanie-przed-po.webp', alt: 'Analiza porównawcza przed/po dla programisty: tempo pracy +354,9%, produktywność netto, regularność +100,7%', caption: 'Analiza przed/po dla pojedynczego programisty — tempo pracy, regularność, produktywność netto.' },
        { src: '/img/devlens/02-profil-velocity-wzrost.webp', alt: 'Profil programisty z wykresem efektywności rosnącym po wdrożeniu AI', caption: 'Profil programisty — wyraźny wzrost liczby zmian w kolejnych miesiącach pracy z agentami.' },
        { src: '/img/devlens/03-profil-improving.webp', alt: 'Profil programisty z rosnącym trendem wydajności od daty wdrożenia oznaczonej na wykresie', caption: 'Data wdrożenia oznaczona na wykresie — widać moment, w którym zespół zaczął pracować z AI.' },
      ]} />
      <p class="rv" style="margin-top:var(--space-lg);color:var(--color-text-2);font-size:var(--text-s,.875rem)">Zrzuty z naszej platformy <a href="/devlens">DevLens Pro</a> — dane z realnego wdrożenia, zanonimizowane.</p>
    </div>
  </section>

  <!-- 04 dlaczego SZRON (ciemna) -->
  <section class="sect sect--dark" aria-labelledby="dlaczego">
    <div class="container">
      <SectHead eyebrow="04 / Dlaczego SZRON · Co nas wyróżnia" title="Transfer wiedzy, nie uzależnienie." id="dlaczego" />
      <dl class="def-rows rv">
        <div><dt>Transfer wiedzy, nie uzależnienie<small>Niezależni po 1–3 miesiącach</small></dt><dd>Po 1–3 miesiącach Wasz zespół pewnie pracuje z AI. Wracamy co kwartał z aktualizacją narzędzi i strategii.</dd></div>
        <div><dt>Praktyczne doświadczenie<small>25+ lat w branży tech</small></dt><dd>Wdrażaliśmy AI, gdy inni dopiero słyszeli o ChatGPT.</dd></div>
        <div><dt>Context Engineering<small>Prompt engineering to za mało</small></dt><dd>Uczymy zaawansowanych technik — liczy się kontekst, nie pojedynczy prompt.</dd></div>
        <div><dt>Mierzalne wyniki<small>ROI na twardych danych</small></dt><dd>Pokazujemy ROI i mierzymy produktywność przed i po wdrożeniu.</dd></div>
      </dl>
    </div>
  </section>

  <!-- 05 FAQ -->
  <section class="sect" aria-labelledby="faq-title">
    <div class="container">
      <SectHead eyebrow="05 / FAQ · Najczęstsze pytania" title="Pytania, które padają najczęściej." id="faq-title" small />
      <Faq items={faq} />
    </div>
  </section>

  <!-- kontakt CTA -->
  <CtaBand
    eyebrow="Kontakt"
    heading="Gotowi na szybszy zespół?"
    text="Umówcie rozmowę i pokażcie swoim devom, jak pracować z AI. NDA przed startem, szczegóły finansowe omawiamy indywidualnie."
    btnLabel="Umów demo"
  />
</Interior>
