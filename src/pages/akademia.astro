---
import Interior from '../layouts/Interior.astro';
import SectHead from '../components/SectHead.astro';
import CtaBand from '../components/CtaBand.astro';
import { akademia } from '../data/akademia.mjs';
---
<Interior
  title="Akademia SZRON — szkolenia z programowania agentowego"
  description="Akademia SZRON: praktyczne materiały z Claude Code, MCP, lokalnych modeli LLM i workflow agentowego. Wiedza, którą wdrażamy u klientów — teraz otwarta."
  eyebrow="Akademia SZRON"
  heading="Programowanie agentowe. Tak, jak robimy to u klientów."
  lead="Materiały z naszych wdrożeń: instalacja i workflow Claude Code, serwery MCP, lokalne modele LLM, bezpieczeństwo pracy z AI na firmowym kodzie. Aktualne komendy, realne pułapki, zero teorii dla teorii."
  heroImage="/img/sub/akademia.webp"
  heroTone="ice"
  heroAlt="Otwarta księga z lodu z pomarańczowymi drobinami światła"
>
  <section class="sect">
    <div class="container">
      <SectHead eyebrow="Wszystkie szkolenia" title={`${akademia.length} ścieżek — od pierwszej instalacji po model na własnym serwerze.`} small />
      <div class="callout rv">
        <strong>Połowa każdego szkolenia jest otwarta. Całość — po zalogowaniu.</strong>
        <p>Konto zakładamy przy <a href="/darmowy-audyt">darmowym audycie</a> i dla uczestników naszych szkoleń. Jedno konto odblokowuje wszystkie ścieżki Akademii.</p>
      </div>
      <img class="hero-img rv" src="/img/sub/akademia-szkolenie.webp" alt="Tomek prowadzi szkolenie przed dużym ekranem z terminalem, uczestnicy z laptopami" width="1380" height="768" loading="lazy" />
      <div class="link-cards link-cards--num rv">
        {akademia.map((a) => (
          <a class="link-card" href={`/${a.slug}`}>
            <h3>{a.title}</h3>
            <p>{a.desc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CtaBand
    id={null}
    padTop={false}
    heading="Chcecie, żeby tak pracował cały Wasz zespół?"
    ghostLabel="Zobacz metodę"
    ghostHref="/metoda"
  />
</Interior>
