---
import Interior from '../layouts/Interior.astro';
import SectHead from '../components/SectHead.astro';
import ProofStrip from '../components/ProofStrip.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import ShotGallery from '../components/ShotGallery.astro';

// FAQ — numeracja 01…NN generowana w <Faq />; pole a = surowy HTML (set:html)
const faq = [
  { q: 'Czym DevLens różni się od standardowego GitHub lub GitLab analytics?', a: 'GitHub i GitLab dostarczają surowe dane techniczne dla programistów. DevLens tłumaczy je na język biznesu dla zarządu: nie „commits”, tylko tempo dostarczania wartości. Dochodzi Bus Factor — wskaźnik ryzyka ciągłości nieobecny w standardowych narzędziach — agregacja multi-repo i raporty wykonawcze gotowe do prezentacji. To narzędzie dla C-level, nie dla developerów.' },
  { q: 'Co to jest Bus Factor i dlaczego jest krytyczny dla zarządu?', a: 'Bus Factor to liczba kluczowych osób, których odejście całkowicie sparaliżuje projekt. Bus Factor równy 1 oznacza, że odejście jednej osoby zatrzyma rozwój. Konsekwencje biznesowe to ryzyko ciągłości, koszt i czas rekrutacji oraz utracone przychody. DevLens identyfikuje projekty z niskim Bus Factor i sugeruje akcje: cross-team code review, dokumentację, pair programming.' },
  { q: 'Czy moje dane z repozytoriów są bezpieczne?', a: 'Tak. Wszystkie tokeny dostępu i dane analityczne trzymane są tylko w Waszej przeglądarce. Zero wysyłania danych do naszych serwerów, weryfikowalne audytem kodu. Przy włączonej integracji AI do zewnętrznego API trafiają wyłącznie zagregowane statystyki, nie kod, i tylko za Waszą zgodą. Zgodność z RODO od pierwszego dnia, możliwość self-hostingu w wariancie enterprise.' },
  { q: 'Jak długo trwa wdrożenie?', a: 'Platformę można uruchomić w 1–2 dni. Dnia pierwszego generujecie token dostępu read-only z GitHub lub GitLab i konfigurujecie repozytoria. Dnia drugiego DevLens agreguje dane i generuje pierwsze raporty. W pierwszym tygodniu dostrajamy dashboardy do Waszych KPI. Brak infrastruktury — działa w przeglądarce, zero instalacji serwerów.' },
  { q: 'Jakie repozytoria i platformy są wspierane?', a: 'DevLens obsługuje dwie platformy do wyboru: GitHub (github.com oraz GitHub Enterprise) i GitLab (gitlab.com oraz self-hosted GitLab). W danym wdrożeniu integrujemy się z jedną z nich i łączymy dowolną liczbę repozytoriów w jej obrębie. Wymagany jest read-only access token — bez uprawnień do zapisu.' },
];
---
<Interior
  title="DevLens — analityka zespołów dev dla zarządu | SZRON"
  description="Platforma analityczna dla zarządu: wydajność zespołów dev, Bus Factor i wskaźniki strategiczne z repozytoriów GitHub lub GitLab. Dane zostają u Was."
  eyebrow="DevLens Pro · audytor procesów deweloperskich"
  heading="Zarząd pyta liczbami. DevLens odpowiada danymi."
  lead="Ile kosztuje ten zespół? Kto jest przeciążony? Co się stanie, jak ktoś odejdzie? DevLens liczy odpowiedzi wprost z Waszych repozytoriów GitHub lub GitLab — zamiast przeczuć i ankiet."
  heroImage="/img/sub/devlens.webp"
  heroTone="ice"
  heroAlt="Dashboard wykresów wyrzeźbiony z lodu z pomarańczowymi liniami danych"
>
  <!-- proof -->
  <ProofStrip items={[
    ['+266% tempa pracy', 'pomiar z realnego wdrożenia'],
    ['Bus Factor', 'wskaźnik ryzyka ciągłości'],
    ['1–2 dni', 'wdrożenie — bez instalacji serwerów'],
  ]} />

  <!-- 01 funkcje i korzyści (scalone) -->
  <section class="sect" aria-labelledby="funkcje">
    <div class="container">
      <SectHead eyebrow="01 / Funkcje i korzyści · Dla zarządu, nie dla programistów" title="Surowe dane z kodu przetłumaczone na KPI i decyzje." id="funkcje" />
      <ShotGallery items={[
        { src: '/img/devlens/01-dashboard.webp', alt: 'Panel zespołu DevLens: 24,2 tys. zmian, 45 programistów, wykres produktywności zespołu z trendem +124%', caption: 'Panel zespołu — produktywność, ryzyko i aktywność 45 programistów w jednym widoku.' },
        { src: '/img/devlens/08-ryzyko-ciaglosci.webp', alt: 'Analiza ryzyka i ciągłości wiedzy: poziom ryzyka 3/10, koncentracja wiedzy, gotowość sukcesji, podsumowanie dla zarządu', caption: 'Analiza ryzyka i ciągłości wiedzy — Bus Factor rozbity na czynniki, z podsumowaniem dla zarządu.' },
        { src: '/img/devlens/06-aktywnosc-tygodniowa.webp', alt: 'Wykres aktywności tygodniowej top 10 programistów na przestrzeni roku', caption: 'Aktywność tygodniowa — kto pracuje regularnie, a kto zrywami. Top 5/10/20 lub cały zespół.' },
        { src: '/img/devlens/10-technologie-profile.webp', alt: 'Profile specjalizacji programistów: obszary pracy, kluczowe technologie i unikalna wiedza każdej osoby', caption: 'Profile specjalizacji — czym zajmuje się każdy programista i czyja wiedza jest unikalna.' },
        { src: '/img/devlens/09-projekty-breakdown.webp', alt: 'Profil programisty: kamienie milowe, rozkład zaangażowania w projekty i ostatnie zmiany w kodzie', caption: 'Profil programisty — kamienie milowe, rozkład pracy między projektami i ostatnie zmiany.' },
      ]} />
      <dl class="def-rows rv" style="margin-top:var(--space-2xl)">
        <div><dt>Tempo i trend zespołu<small>Czy inwestycja w programistów się zwraca</small></dt><dd>24,2 tys. zmian i 45 programistów w jednym widoku, trend produktywności policzony z historii repozytoriów (na zrzucie: +124%). Zarząd czyta wynik, nie kod.</dd></div>
        <div><dt>Ryzyko ciągłości<small>Bus Factor — większość firm nie zna tej liczby</small></dt><dd>Ile kluczowych osób musi odejść, żeby projekt stanął. DevLens rozbija ryzyko na koncentrację wiedzy i gotowość sukcesji (na zrzucie: poziom 3/10) i wskazuje projekty zależne od jednej głowy.</dd></div>
        <div><dt>Efekt wdrożenia AI<small>Pomiar przed/po, nie wrażenia</small></dt><dd>Porównanie tempa pracy przed i po dacie wdrożenia narzędzi AI — w realnym wdrożeniu pomiar pokazał średnio +266% tempa pracy zespołu.</dd></div>
        <div><dt>Przeciążenia i unikalna wiedza<small>Kogo odciążyć, kogo dublować</small></dt><dd>Aktywność tygodniowa pokazuje, kto pracuje ponad miarę, a profile specjalizacji — które kompetencje istnieją w firmie w jednym egzemplarzu.</dd></div>
        <div><dt>Raporty w języku zarządu<small>Wszystkie projekty w jednym miejscu</small></dt><dd>Dowolna liczba repozytoriów zagregowana w dashboardy dla kadry zarządzającej i raporty wykonawcze — bez tłumaczenia z technicznego.</dd></div>
      </dl>
    </div>
  </section>

  <!-- 02 integracja AI (ciemna) -->
  <section class="sect sect--dark" aria-labelledby="ai">
    <div class="container">
      <SectHead eyebrow="02 / Integracja z AI · Opcjonalnie" title="AI generuje podsumowania wykonawcze i rekomendacje." id="ai">
        <p class="sect-lead rv">Integrację włączacie opcjonalnie. Do zewnętrznego API trafiają wtedy wyłącznie zagregowane statystyki, nigdy kod.</p>
      </SectHead>
      <div class="grid-cards">
        <article class="card-tile rv">
          <p class="eyebrow">01 / Podsumowania</p>
          <h3>Automatyczne raporty wykonawcze</h3>
          <p>Integracja z AI generuje raporty gotowe do prezentacji zarządowi.</p>
        </article>
        <article class="card-tile rv" style="--rv-d:.08s">
          <p class="eyebrow">02 / Rekomendacje</p>
          <h3>Strategiczne sugestie</h3>
          <p>AI analizuje dane i sugeruje akcje — od realokacji zasobów po rekrutację.</p>
        </article>
        <article class="card-tile rv" style="--rv-d:.16s">
          <p class="eyebrow">03 / Anomalie</p>
          <h3>Wykrywanie problemów</h3>
          <p>Automatyczna identyfikacja nietypowych wzorców wydajności i potencjalnych problemów.</p>
        </article>
      </div>
      <ShotGallery cols={1} items={[
        { src: '/img/devlens/07-prompty-ai.webp', alt: 'Widok Analiza AI: lista promptów wysłanych do agenta Claude Code pogrupowana w sesje i projekty', caption: 'Analiza AI — jak zespół realnie korzysta z agentów: prompty, sesje i projekty w jednym widoku.' },
      ]} />
    </div>
  </section>

  <!-- 03 dla kogo -->
  <section class="sect" aria-labelledby="dlakogo">
    <div class="container">
      <SectHead eyebrow="03 / Dla kogo · Role w zarządzie" title="CEO, CTO, CFO, PM — każdy dostaje odpowiedź na swoje pytanie." id="dlakogo" small />
      <dl class="def-rows rv">
        <div><dt>CEO / Zarząd<small>Czy inwestycja w zespół się zwraca?</small></dt><dd>DevLens pokazuje tempo dostarczania funkcji, trendy wydajności i zwrot z inwestycji w programistów.</dd></div>
        <div><dt>CTO / Dyrektor IT<small>Gdzie są wąskie gardła i ryzyka?</small></dt><dd>Bus Factor, analiza zależności między projektami, wskaźniki stagnacji — wszystko w jednym miejscu.</dd></div>
        <div><dt>CFO / Dyrektor Finansowy<small>Jak uzasadnić budżet na zespół?</small></dt><dd>Konkretne metryki produktywności, analiza zwrotu z narzędzi AI i historyczne trendy efektywności.</dd></div>
        <div><dt>Project Manager<small>Jak przewidzieć opóźnienia?</small></dt><dd>Trendy velocity zespołu, analiza historyczna podobnych projektów i wczesne ostrzeżenia o spadkach produktywności.</dd></div>
      </dl>
    </div>
  </section>

  <!-- 04 bezpieczeństwo (ciemna) -->
  <section class="sect sect--dark" aria-labelledby="bezp">
    <div class="container">
      <SectHead eyebrow="04 / Bezpieczeństwo · Korporacyjne" title="Dane wrażliwe zostają wyłącznie w przeglądarce." id="bezp">
        <p class="sect-lead rv">Tokeny dostępu i dane analityczne zostają w przeglądarce użytkownika. Na nasze serwery nie trafia nic.</p>
      </SectHead>
      <div class="grid-cards">
        <article class="card-tile rv">
          <p class="eyebrow">01 / Lokalne przetwarzanie</p>
          <h3>Zero serwerów zewnętrznych</h3>
          <p>Cała analityka liczona lokalnie — do zweryfikowania audytem kodu.</p>
        </article>
        <article class="card-tile rv" style="--rv-d:.08s">
          <p class="eyebrow">02 / Compliance RODO</p>
          <h3>RODO i self-hosting</h3>
          <p>Dane pod Waszą kontrolą — zgodność z RODO, w wariancie enterprise self-hosting.</p>
        </article>
        <article class="card-tile rv" style="--rv-d:.16s">
          <p class="eyebrow">03 / Eksport danych</p>
          <h3>Formaty offline</h3>
          <p>Pełny eksport wszystkich analiz do formatów offline — CSV, JSON, PDF.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- 05 FAQ -->
  <section class="sect" aria-labelledby="faq-title">
    <div class="container">
      <SectHead eyebrow="05 / FAQ · Pytania o DevLens Pro" title="Najczęstsze pytania o platformę analityczną dla zarządu." id="faq-title" small />
      <Faq items={faq} />
    </div>
  </section>

  <!-- kontakt CTA -->
  <CtaBand
    eyebrow="Kontakt"
    heading="Zobaczcie DevLens na swoich danych."
    text="Zamiast prezentacji o funkcjach — pilot na Waszych repozytoriach: pierwszy raport z Waszego kodu i 90 minut rozmowy o tym, co z niego wynika."
    btnLabel="Umów pilot DevLens"
  />
</Interior>
