---
import Interior from '../layouts/Interior.astro';
import SectHead from '../components/SectHead.astro';
import ProofStrip from '../components/ProofStrip.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';

// FAQ — numeracja 01…NN generowana w <Faq />; pole a = surowy HTML (set:html)
const faq = [
  { q: 'Jakie narzędzia AI wdrażacie?', a: 'Cursor IDE, Claude Code CLI, GitHub Copilot, Gemini CLI, Windsurf, Aider, MCP Tools (Supabase, Figma, ChromeDevTools, Playwright), lokalne modele AI oraz firmowy chatbot z pamięcią między agentami. Do tego pełna konfiguracja: reguły projektu, własne umiejętności, integracje MCP. Zakres dobieramy do waszego stacku — np. React/TypeScript to Copilot, Cursor i MCP Supabase, embedded C++ to Claude Code z integracją Keil, mobile React Native to cały zestaw.' },
  { q: 'Jak działa Context Engineering w praktyce?', a: 'To personalizacja agentów AI przez pliki konfiguracyjne w Markdown w repozytorium. Plik zawiera Git workflow, konwencje nazewnictwa i praktyki bezpieczeństwa, definiuje własne narzędzia (MCP Supabase do bazy, Playwright do testów), a agent czyta ten kontekst przy każdym uruchomieniu. Efekt: agent nie pyta o oczywiste, działa zgodnie z konwencjami zespołu i używa właściwych narzędzi.' },
  { q: 'Czy AI działa z moim stackiem (PHP, C++, React, embedded)?', a: 'Tak — AI działa z każdym stackiem. Przykłady: migracja PHP 5.6 do 8.2 z Copilotem w 2 tygodnie; C++ embedded (STM32 + Keil) z Claude Code i Rust, drukarka RS232 w 1,5 dnia; React Native z Cursor i Copilotem; legacy Qt/QML z Gemini CLI; Python i Pandas z Claude Code, system raportowania w tydzień. Wymóg: repozytorium Git i README z instrukcją setupu.' },
  { q: 'Jak wygląda model współpracy?', a: 'Zaczynamy od zobowiązania kwartalnego — 3 miesiące diagnozy, setupu narzędzi i coachingu na waszych taskach. Po kwartale mamy twarde dane. Potem przechodzimy na model miesięczny: review, aktualizacja narzędzi, wsparcie ad-hoc. Szczegóły finansowe omawiamy indywidualnie.' },
  { q: 'Jak wygląda droga od pierwszego kontaktu do startu?', a: 'Discovery call (poznajemy biznes, use case\'y, zespół i stack), dobór pakietu, oferta z timeline\'em i szacunkiem zwrotu, umowa, a potem kickoff w pierwszym tygodniu: analiza workflow, mapowanie zadań, dobór narzędzi. Zwykle 2–3 tygodnie od kontaktu do szkolenia, w trybie pilnym szybciej.' },
];
---
<Interior
  title="Transformacja AI dla zespołów dev | SZRON"
  description="Transformacja AI dla zespołów dev: Cursor, Claude Code, Copilot, Codex, Gemini CLI i MCP Tools w setupie pod wasz stack. Audyt, strategia, transfer wiedzy."
  eyebrow="Zobowiązanie kwartalne · potem model miesięczny"
  heading="Transformacja AI dla Waszego zespołu."
  lead="Siadamy do kodu razem z waszymi devami, dobieramy narzędzia i uczymy ich pracować z AI na co dzień. Cztery kroki, w których budujemy umiejętności u waszych ludzi — nie zawsze idzie gładko, ale zawsze idziemy do przodu."
  heroImage="/img/sub/transformacja-ai.webp"
  heroAlt="Pęknięty lód przechodzący w świecącą kratę kryształów"
>
  <!-- proof -->
  <ProofStrip items={[
    ['Na waszym repo', 'efekty od pierwszego dnia'],
    ['Setup pod wasz stack', 'Cursor, Claude Code, Copilot, MCP Tools'],
    ['Niezależni po 30 dniach', 'zespół przejmuje stery'],
  ]} />

  <!-- 01 cytat -->
  <section class="sect" aria-labelledby="punkt">
    <div class="container">
      <SectHead eyebrow="01 / Punkt wyjścia · Skala efektu" title="Prawda jest gdzieś pośrodku — ale bliżej optymistycznych szacunków." id="punkt" small />
      <img class="hero-img rv" src="/img/sub/transformacja-ai-praca.webp" alt="Programowanie w parze z panelem asystenta AI widocznym na szerokim monitorze" width="1380" height="768" loading="lazy" />
      <div class="grid-cards">
        <figure class="quote-card rv">
          <blockquote>„Jeden zaawansowany we współpracy z AI pracownik jest w stanie wykonać zadania, które wcześniej wymagały pracy kilkudziesięcioosobowego zespołu."</blockquote>
          <figcaption><strong>The New York Times</strong> — maj 2025</figcaption>
        </figure>
        <article class="card-tile rv" style="--rv-d:.1s">
          <p class="eyebrow">Z doświadczenia</p>
          <h3>Liczby trzymane konserwatywnie.</h3>
          <p>McKinsey mówi o kilkuset procentach zwrotu, NYT o jednym devie za kilkuosobowy zespół. Wolimy pozytywnie zaskoczyć niż obiecać za dużo — dlatego pokazujemy ostrożne szacunki.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- 02 proces (ciemna) -->
  <section class="sect sect--dark" aria-labelledby="proces">
    <div class="container">
      <SectHead eyebrow="02 / Proces · Jak wygląda transformacja AI" title="Cztery kroki. Każdy buduje umiejętności u Waszych ludzi." id="proces" />
      <div class="steps">
        <article class="step rv"><p class="eyebrow">01 · Audyt</p><h3>Audyt technologiczny</h3><p>Przychodzimy, patrzymy jak działacie, rozmawiamy z ludźmi. Szukamy miejsc, gdzie tracicie czas i pieniądze, co da się zautomatyzować od zaraz i gdzie AI da największy efekt.</p></article>
        <article class="step rv" style="--rv-d:.08s"><p class="eyebrow">02 · Strategia</p><h3>Strategia AI</h3><p>Razem ustalamy, co robimy najpierw, co potem, a co pomijamy. Konkretny plan z kolejnością, projekty z najszybszym zwrotem i przeprowadzenie zespołu przez zmianę. Nie każdy proces potrzebuje AI — mówimy to wprost.</p></article>
        <article class="step rv" style="--rv-d:.16s"><p class="eyebrow">03 · Optymalizacja</p><h3>Optymalizacja procesów</h3><p>Wchodzimy w wasze workflow i szukamy miejsc, gdzie AI skróci robotę. Dopasowanie do procesów, wpięcie w istniejące systemy, przyspieszenie codziennej pracy i ciągłe mierzenie.</p></article>
        <article class="step rv" style="--rv-d:.24s"><p class="eyebrow">04 · Transfer</p><h3>Zespół przejmuje stery</h3><p>Uczymy waszych ludzi tak, żeby po miesiącu pewnie pracowali z AI na co dzień. Wyłaniamy liderów AI, pracujemy na waszym kodzie, zostawiamy dokumentację. A wracamy co kwartał z nowymi narzędziami.</p></article>
      </div>
    </div>
  </section>

  <!-- 03 narzędzia dev -->
  <section class="sect" aria-labelledby="narzedzia">
    <div class="container">
      <SectHead eyebrow="03 / Setup · Transformacja zespołów deweloperskich" title="Agent AI jako drugi mózg programisty. Context Engineering zamiast prompt engineeringu." id="narzedzia" />
      <dl class="def-rows rv">
        <div><dt>GitHub Copilot i Cursor IDE<small>Kodowanie wspierane AI</small></dt><dd>AI w VSCode i Cursor — znacząco szybsze pisanie kodu na co dzień.</dd></div>
        <div><dt>Claude Code i Gemini CLI<small>Agenci AI w terminalu</small></dt><dd>Pełna autonomia w refactoringu i debugowaniu z poziomu wiersza poleceń.</dd></div>
        <div><dt>MCP Tools<small>Integracje agentów z systemami</small></dt><dd>ChromeDevTools (wydajność), Playwright (testy), Supabase (baza), Figma (UI) — wpięte w pracę agenta.</dd></div>
        <div><dt>Wsparcie stacku<small>Legacy i nowoczesny</small></dt><dd>React, React Native, TypeScript, PHP (legacy do 8.2), C++ embedded, Qt/QML.</dd></div>
        <div><dt>Markdown Configuration<small>Personalizacja agentów AI</small></dt><dd>Nowa dyscyplina wypierająca prompt engineering: agent czyta kontekst projektu przy każdym uruchomieniu i działa zgodnie z konwencjami zespołu.</dd></div>
        <div><dt>Self-Improving Loops<small>Agent uczy się z błędów</small></dt><dd>Agent sam sprawdza, poprawia i iteruje. Git workflow z AI (commit po zmianie, rollback, quality gates) i integracja CI/CD spinają całość w jedną pętlę.</dd></div>
      </dl>
    </div>
  </section>

  <!-- 04 korzyści wg skali -->
  <section class="sect" aria-labelledby="korzysci" style="padding-top:0">
    <div class="container">
      <SectHead eyebrow="04 / Skala · Korzyści wg wielkości zespołu" title="Inne podejście dla 2–5 devów, inne dla 5+ devów." id="korzysci" small />
      <div class="grid-cards">
        <article class="card-tile rv">
          <p class="eyebrow">Mały zespół · 2–5 devów</p>
          <h3>Szybkie efekty na waszym repo</h3>
          <p>Pracujemy na waszym repozytorium — efekty widać od pierwszego dnia. Szybkie wdrożenie narzędzi AI (Cursor, Claude Code, Copilot, Codex, Gemini CLI, Windsurf, Aider), a zespół przejmuje stery po zakończeniu programu.</p>
        </article>
        <article class="card-tile rv" style="--rv-d:.1s">
          <p class="eyebrow">Duży zespół · 5+ devów</p>
          <h3>Standard i samodzielność</h3>
          <p>Budowanie samodzielności i wyłanianie liderów AI w zespole. Jeden standard narzędzi AI we wszystkich działach oraz twarde KPI i dokumentacja, z którą pójdziecie do zarządu.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- 05 zastosowania wg zespołów (ciemna) -->
  <section class="sect sect--dark" aria-labelledby="zespoly">
    <div class="container">
      <SectHead eyebrow="05 / Zastosowania · Co wdrażamy w różnych zespołach" title="Każdy zespół ma inny stack i inne wyzwania." id="zespoly" />
      <dl class="def-rows rv">
        <div><dt>Backend Team</dt><dd>Claude Code CLI do refactoringu, MCP Tools do baz danych, automatyczne testy i quality gates, Context Engineering dla API.</dd></div>
        <div><dt>Frontend Team</dt><dd>Cursor IDE z agentem AI, Copilot do komponentów, MCP Figma do pixel-perfect, Playwright do testów E2E.</dd></div>
        <div><dt>Mobile Team</dt><dd>React Native z AI, development cross-platform, automatyzacja App Store i Google Play, profilowanie wydajności z AI.</dd></div>
        <div><dt>Embedded Team</dt><dd>Claude Code do C/C++, Rust z asystentem AI, komunikacja RS232/USB, integracja z toolchainami.</dd></div>
      </dl>
    </div>
  </section>

  <!-- 06 ROI / wpływ na biznes -->
  <section class="sect" aria-labelledby="roi">
    <div class="container">
      <SectHead eyebrow="06 / Zwrot · Wpływ na biznes" title="Podajemy konserwatywne szacunki. Rzeczywiste wyniki często są lepsze." id="roi" small />
      <table class="results-table rv">
        <thead><tr><th scope="col">Obszar</th><th scope="col">Efekt</th></tr></thead>
        <tbody>
          <tr><td>Okres zwrotu inwestycji</td><td><strong>typowo kilka miesięcy, zwykle 4–8</strong></td></tr>
          <tr><td>Koszt vs własny zespół AI</td><td><strong>do 80% taniej — ułamek kosztu budowy zespołu</strong></td></tr>
          <tr><td>Zwiększenie przychodów</td><td><strong>+35–55% dzięki personalizacji AI i optymalizacji cen</strong></td></tr>
          <tr><td>Redukcja kosztów</td><td><strong>-30–50% przez automatyzację powtarzalnych procesów</strong></td></tr>
          <tr><td>Eliminacja błędów</td><td><strong>-70–80% błędów ludzkich w procesach</strong></td></tr>
          <tr><td>Przyspieszenie rozwoju</td><td><strong>3x szybsze projekty (NYT 2025)</strong></td></tr>
        </tbody>
      </table>
      <ProofStrip wrap={false} items={[
        ['60–80%', 'szybsze kodowanie (GitHub 2024)'],
        ['55,8%', 'szybciej (badanie GitHub)'],
        ['ROI 150–300%', 'wg McKinsey Digital'],
      ]} />
    </div>
  </section>

  <!-- 07 Self-Improving Loops (ciemna) -->
  <section class="sect sect--dark" aria-labelledby="loops">
    <div class="container">
      <SectHead eyebrow="07 / Pętla · Self-Improving Loops" title="Agent, który sam sprawdza, poprawia i iteruje — aż kod działa." id="loops" />
      <div class="steps">
        <article class="step rv"><p class="eyebrow">01 · Sprawdza</p><h3>Uruchamia i weryfikuje</h3><p>Agent uruchamia kod i testy, weryfikuje działanie z MCP Tools (ChromeDevTools, Playwright).</p></article>
        <article class="step rv" style="--rv-d:.08s"><p class="eyebrow">02 · Poprawia</p><h3>Automatycznie</h3><p>Naprawia błędy, optymalizuje wydajność, refaktoruje kod — bez interwencji człowieka.</p></article>
        <article class="step rv" style="--rv-d:.16s"><p class="eyebrow">03 · Powtarza</p><h3>Aż działa</h3><p>Iteruje dopóki nie osiągnie celu i wszystkie testy nie przejdą. Podwojone tempo pracy to dopiero początek.</p></article>
      </div>
      <dl class="def-rows rv">
        <div><dt>Optymalizacja JavaScript<small>„Ten mechanizm działa wolno. Spraw, żeby przyspieszył."</small></dt><dd>5x przyspieszenie w 3 minuty, z ChromeDevTools MCP i profilowaniem.</dd></div>
        <div><dt>Drukarka RS232 (embedded)<small>„Potrzebujemy komunikacji z drukarką przez RS232."</small></dt><dd>1,5 dnia zamiast miesiąca, na Rust + STM32 z toolchainem Keil.</dd></div>
      </dl>
    </div>
  </section>

  <!-- 08 FAQ -->
  <section class="sect" aria-labelledby="faq-title">
    <div class="container">
      <SectHead eyebrow="08 / FAQ · Czego się spodziewać" title="Pytania o transformację AI." id="faq-title" small />
      <Faq items={faq} />
    </div>
  </section>

  <!-- kontakt CTA -->
  <CtaBand
    eyebrow="Kontakt"
    heading="Sprawdź bez ryzyka. Zacznij od rozmowy."
    text="Powiemy wprost, co jest realne dla waszej firmy, a co to tylko hype. Dostaniecie konkretny plan i szacunek zwrotu. NDA przed startem, szczegóły finansowe omawiamy indywidualnie."
    btnLabel="Umów bezpłatną konsultację"
  />
</Interior>
