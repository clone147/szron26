---
import Interior from '../layouts/Interior.astro';
import SectHead from '../components/SectHead.astro';
import ProofStrip from '../components/ProofStrip.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';

// FAQ — numeracja 01…NN generowana w <Faq />; pole a = surowy HTML (set:html)
const faq = [
  { q: 'Czym rola CTrO różni się od programu kwartalnego?', a: 'Program kwartalny to zamknięty projekt: zakres, stała opłata, pomiar przed i po. Rola CTrO to stała odpowiedzialność za zmianę — priorytety, standardy, kolejne zespoły, raportowanie zarządowi. W praktyce program często jest pierwszym kwartałem roli: najpierw dowozimy mierzalny efekt, potem prowadzimy zmianę dalej.' },
  { q: 'Ile czasu zajmuje ta rola i czy zastępuje CTO?', a: 'Kilka dni w miesiącu, zakres ustalany kwartalnie. Nie zastępujemy CTO ani dyrektora R&D — pracujemy obok: oni odpowiadają za produkt i zespół, my za to, żeby zmiana sposobu pracy naprawdę zaszła i była policzalna.' },
  { q: 'Czy AI działa z naszym stackiem (PHP, C++, React, embedded)?', a: 'Tak — AI działa z każdym stackiem. Przykłady: migracja PHP 5.6 do 8.2 w 2 tygodnie, komunikacja z drukarką RS232 na STM32 w 1,5 dnia, system raportowania w Pythonie w tydzień. Szczegóły narzędzi i konfiguracji — na <a href="/transformacja-ai-dla-programistow">stronie dla CTO i tech leadów</a>.' },
  { q: 'Jak wygląda droga od pierwszego kontaktu do startu?', a: 'Audyt 90 minut (poznajemy biznes, use case\'y, zespół i stack — z pisemnym raportem), potem oferta z timeline\'em i kwota mailem w 48 godzin, umowa i kickoff. Zwykle 2–3 tygodnie od kontaktu do pierwszych działań, w trybie pilnym szybciej. NDA przed startem.' },
];
---
<Interior
  title="Zewnętrzny Chief Transformation Officer — transformacja AI | SZRON"
  description="Zewnętrzny Chief Transformation Officer dla firm z własnym zespołem IT: prowadzi transformację AI od środka — priorytety, standardy, pomiar efektu. Wejście od bezpłatnego audytu 90 minut z pisemnym raportem."
  eyebrow="Rola · Zewnętrzny Chief Transformation Officer"
  heading="Transformacja ma właściciela. Nie musi być na etacie."
  lead="Dla firm, które mają transformację w PowerPoincie: licencje kupione, strategia ogłoszona, a zespoły pracują po staremu. Wchodzimy w rolę zewnętrznego Chief Transformation Officera — prowadzimy zmianę sposobu pracy od środka i mierzymy efekt. AI jest tu narzędziem, nie nagłówkiem."
  heroImage="/img/sub/transformacja-ai.webp"
  heroTone="ice"
  heroAlt="Pęknięty lód przechodzący w świecącą kratę kryształów"
>
  <!-- proof -->
  <ProofStrip items={[
    ['Rola, nie projekt', 'kilka dni w miesiącu, stała odpowiedzialność'],
    ['Pomiar przed i po', 'DevLens: liczby dla zarządu, nie deklaracje'],
    ['Wejście bez ryzyka', 'bezpłatny audyt 90 minut z pisemnym raportem'],
  ]} />

  <!-- 01 punkt wyjścia -->
  <section class="sect" aria-labelledby="punkt">
    <div class="container">
      <SectHead eyebrow="01 / Punkt wyjścia · Dlaczego to się nie dzieje samo" title="Licencje są. Strategia jest. Delivery stoi w miejscu." id="punkt" small />
      <img class="hero-img rv" src="/img/sub/transformacja-ai-praca.webp" alt="Programowanie w parze z panelem asystenta AI widocznym na szerokim monitorze" width="1380" height="768" loading="lazy" />
      <div class="grid-cards">
        <figure class="quote-card rv">
          <blockquote>„Jeden zaawansowany we współpracy z AI pracownik jest w stanie wykonać zadania, które wcześniej wymagały pracy kilkudziesięcioosobowego zespołu."</blockquote>
          <figcaption><strong>The New York Times</strong> — maj 2025</figcaption>
        </figure>
        <article class="card-tile rv" style="--rv-d:.1s">
          <p class="eyebrow">Paradoks produktywności AI</p>
          <h3>Licencja wpięta w stary proces daje stare wyniki.</h3>
          <p>84% programistów już używa AI, a delivery stoi — bo zmieniło się narzędzie, nie sposób pracy. Firmy, które przeprojektowały workflow, wyciągają ROI 2,5–3,5×. Dokładnie za tę różnicę odpowiada CTrO.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- 02 zakres roli (ciemna) -->
  <section class="sect sect--dark" aria-labelledby="rola">
    <div class="container">
      <SectHead eyebrow="02 / Zakres · Co bierze na siebie zewnętrzny CTrO" title="Odpowiedzialność za zmianę sposobu pracy. Nie za slajdy o AI." id="rola" />
      <dl class="def-rows rv">
        <div><dt>Priorytety i plan<small>co najpierw, co potem, czego nie robić</small></dt><dd>Plan kwartalny z kolejnością i projektami o najszybszym zwrocie. Nie każdy proces potrzebuje AI — mówimy to wprost i skreślamy z listy.</dd></div>
        <div><dt>Standardy i workflow<small>sposób pracy, nie narzędzie</small></dt><dd>Definicje zadań, review z agentami, standardy repo i CLAUDE.md jako konstytucja zespołu — żeby zmiana przetrwała bez nas.</dd></div>
        <div><dt>Narzędzia bez lojalności wobec dostawcy<small>dobór pod stack i budżet</small></dt><dd>Dobieramy pod Wasz stack, nie pod prowizję. Gdy kod nie może wyjść z firmy — modele lokalne i rozwiązania self-hosted.</dd></div>
        <div><dt>Pomiar i raportowanie zarządowi<small>DevLens · KPI przed i po</small></dt><dd>Baseline na starcie, te same wskaźniki co kwartał. Zarząd dostaje liczby z własnego zespołu, nie wrażenia z prezentacji.</dd></div>
        <div><dt>Ludzie i kompetencje<small>liderzy AI, szkolenia falami</small></dt><dd>Wyłaniamy championów, szkolimy zespołami na Waszym kodzie, opór rozbrajamy na liczbach — wartość programisty prowadzącego agenta rośnie, nie maleje.</dd></div>
        <div><dt>Governance i regulacje<small>AI Act art. 4 · CRA dla firm z firmware</small></dt><dd>Obowiązek AI literacy i wymogi CRA zamieniamy na proces i szkolenia, nie na panikę. Szczególnie dla firm budujących własny sprzęt i oprogramowanie.</dd></div>
      </dl>
    </div>
  </section>

  <!-- 03 proces -->
  <section class="sect" aria-labelledby="proces">
    <div class="container">
      <SectHead eyebrow="03 / Proces · Jak prowadzimy zmianę" title="Cztery kroki. Każdy buduje umiejętności u Waszych ludzi." id="proces" />
      <div class="steps">
        <article class="step rv"><p class="eyebrow">01 · Audyt</p><h3>Audyt technologiczny</h3><p>Zaczynamy od <a href="/umow-rozmowe">bezpłatnego audytu</a>: przychodzimy, patrzymy jak działacie, rozmawiamy z ludźmi. Szukamy miejsc, gdzie tracicie czas i pieniądze i gdzie AI da największy efekt.</p></article>
        <article class="step rv" style="--rv-d:.08s"><p class="eyebrow">02 · Strategia</p><h3>Strategia AI</h3><p>Razem ustalamy, co robimy najpierw, co potem, a co pomijamy. Konkretny plan z kolejnością, projekty z najszybszym zwrotem i przeprowadzenie zespołu przez zmianę.</p></article>
        <article class="step rv" style="--rv-d:.16s"><p class="eyebrow">03 · Optymalizacja</p><h3>Optymalizacja procesów</h3><p>Wchodzimy w wasze workflow i szukamy miejsc, gdzie AI skróci robotę. Dopasowanie do procesów, wpięcie w istniejące systemy, przyspieszenie codziennej pracy i ciągłe mierzenie.</p></article>
        <article class="step rv" style="--rv-d:.24s"><p class="eyebrow">04 · Transfer</p><h3>Zespół przejmuje stery</h3><p>Uczymy waszych ludzi tak, żeby po miesiącu pewnie pracowali z AI na co dzień. Wyłaniamy liderów AI, pracujemy na waszym kodzie, zostawiamy dokumentację.</p></article>
      </div>
    </div>
  </section>

  <!-- 04 drabina współpracy (ciemna) -->
  <section class="sect sect--dark" aria-labelledby="drabina">
    <div class="container">
      <SectHead eyebrow="04 / Model współpracy · Od audytu do stałej roli" title="Każdy szczebel dowozi wartość. Żaden nie zobowiązuje do następnego." id="drabina" />
      <dl class="def-rows rv">
        <div><dt>Audyt 90 minut<small>bezpłatny · pisemny raport</small></dt><dd>Rozmowa o stacku, zespole i procesie. Wychodzicie z raportem: gdzie AI da u Was największy efekt i co stoi na przeszkodzie. <a href="/umow-rozmowe">Umów audyt</a>.</dd></div>
        <div><dt>Warsztat 1–2 dni<small>na Waszym kodzie</small></dt><dd>Zespół pracuje z agentami na własnych, codziennych zadaniach — nie na przykładach z prezentacji. Pierwsze efekty i wiedza, co realnie zadziała u Was.</dd></div>
        <div><dt>Program kwartalny<small>zespół 2–4× szybszy · pomiar przed i po</small></dt><dd>Zamknięty zakres, stała opłata, baseline w pierwszym tygodniu. Szczegóły procesu — na stronie <a href="/metoda">Metoda</a>.</dd></div>
        <div><dt>Rola stała: zewnętrzny CTrO<small>kilka dni w miesiącu</small></dt><dd>Prowadzenie zmiany dalej: kolejne zespoły, standardy, narzędzia, kwartalne raporty dla zarządu. Odpowiedzialność bez etatu i bez rekrutacji.</dd></div>
      </dl>
    </div>
  </section>

  <!-- 05 pomiar / ROI -->
  <section class="sect" aria-labelledby="roi">
    <div class="container">
      <SectHead eyebrow="05 / Zwrot · Wpływ na biznes" title="Podajemy konserwatywne szacunki. Rzeczywiste wyniki często są lepsze." id="roi" small />
      <table class="results-table rv">
        <thead><tr><th scope="col">Obszar</th><th scope="col">Efekt</th></tr></thead>
        <tbody>
          <tr><td>Tempo pracy zespołu</td><td><strong>+266% po wdrożeniu (pomiar DevLens)</strong></td></tr>
          <tr><td>Przyspieszenie rozwoju</td><td><strong>3x szybsze projekty (NYT 2025)</strong></td></tr>
          <tr><td>Okres zwrotu inwestycji</td><td><strong>typowo kilka miesięcy, zwykle 4–8</strong></td></tr>
        </tbody>
      </table>
      <ProofStrip wrap={false} items={[
        ['60–80%', 'szybsze kodowanie (GitHub 2024)'],
        ['ROI 150–300%', 'wg McKinsey Digital'],
      ]} />
      <p class="rv" style="margin-top:var(--space-lg);color:var(--color-text-2);font-size:var(--text-s,.875rem)">Tempo pracy mierzymy naszą platformą <a href="/devlens">DevLens</a> — dane z realnego wdrożenia, zanonimizowane.</p>
    </div>
  </section>

  <!-- 06 FAQ -->
  <section class="sect" aria-labelledby="faq-title" style="padding-top:0">
    <div class="container">
      <SectHead eyebrow="06 / FAQ · Czego się spodziewać" title="Pytania o rolę i model współpracy." id="faq-title" small />
      <Faq items={faq} />
    </div>
  </section>

  <!-- kontakt CTA -->
  <CtaBand
    eyebrow="Kontakt"
    heading="Sprawdź bez ryzyka. Zacznij od audytu."
    text="Powiemy wprost, co jest realne dla waszej firmy, a co to tylko hype. Po audycie dostaniecie pisemny raport, konkretny plan i kwotę mailem w 48 godzin. NDA przed startem."
    btnLabel="Umów bezpłatny audyt"
  />
</Interior>
