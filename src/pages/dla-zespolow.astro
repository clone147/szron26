---
import Interior from '../layouts/Interior.astro';
import SectHead from '../components/SectHead.astro';
import ProofStrip from '../components/ProofStrip.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';

// FAQ — numeracja 01…NN generowana w <Faq />; pole a = surowy HTML (set:html)
const faq = [
  { q: 'Ile kosztuje program treningowy?', a: 'Szczegóły finansowe omawiamy indywidualnie. Zaczynamy od trzymiesięcznego zobowiązania, w którym udowadniamy wartość. Pierwsza rozmowa jest darmowa — powiemy szczerze, co ma u was sens, a co nie.' },
  { q: 'Czy AI zastąpi naszych programistów?', a: 'Nie. Z doświadczenia — dobry dev z AI jest nie do zastąpienia. AI nie rozumie biznesu, nie podejmie decyzji architektonicznych. Ale rutynowe rzeczy — boilerplate, testy, dokumentacja — robi szybciej. Wasi ludzie skupiają się na tym, co naprawdę wymaga myślenia.' },
  { q: 'Jak długo trwa widoczny efekt?', a: 'Po pierwszym tygodniu widać, że ludzie zaczynają inaczej pracować. Po dwóch tygodniach mamy twarde dane — o ile szybciej idą taski. Pełna zmiana nawyków to 4–8 tygodni. Nie zawsze idzie gładko, ale wyniki przychodzą.' },
  { q: 'Czy dane naszego kodu są bezpieczne?', a: 'To pytanie dostajemy od każdego CTO. Tak — możemy pracować z lokalnymi modelami: LM Studio, Llama, nic nie wychodzi na zewnątrz. Jest też Cursor Privacy Mode. Dla większości zespołów to wystarczy, ale mamy też opcje self-hosted dla tych, którzy potrzebują pełnej kontroli.' },
  { q: 'Jakich narzędzi używacie?', a: 'Agentów AI — głównie Opusa i Sonnet od Anthropic. Uruchamiamy ich przez Claude Code i MCP Tools. Cursor, Copilot, Codex to narzędzia pomocnicze, które też ustawiamy tam, gdzie pasują. Stawiamy project rules, konfigurujemy custom skille, budujemy integracje z waszymi systemami. Testujemy na waszym kodzie i wtedy wiemy, co daje największy skok.' },
  { q: 'Co jeśli nie zobaczymy efektów?', a: 'Jeszcze się nie zdarzyło, żeby zespół po sprincie nie widział różnicy. Ale gdyby tak było — zwracamy pieniądze. Mierzymy przed i po, więc nie ma miejsca na wciskanie kitu.' },
  { q: 'Dla jakiego rozmiaru zespołu to działa?', a: 'Od 3 do 50+ programistów. Dla małych zespołów (3–8) wystarczy sprint. Przy większych (15+) budujemy wewnętrznych championów — ludzi z waszego zespołu, którzy potem uczą resztę. Tak skaluje się wiedza.' },
  { q: 'Czy pracujecie zdalnie?', a: 'Tak, większość pracy robimy zdalnie. Screen sharing, pair programming — działa świetnie. Ale jeśli wolicie, żeby przyjechać na sprint na żywo, też możemy. Polska i kraje nordyckie.' },
];
---
<Interior
  title="Program treningowy AI dla zespołów dev | SZRON"
  description="Wdrażamy agentów AI (Opus, Sonnet) w zespołach dev: Claude Code, MCP Tools i custom skille — pełny setup pod wasz stack. Coaching na waszym kodzie."
  eyebrow="Dla zespołów 3–50+ programistów"
  heading="Nauczymy wasz zespół pracować z AI na co dzień."
  lead="Przychodzimy do waszego repo, patrzymy jak pracujecie i pokazujemy konkretne rzeczy do zmiany od razu. Dobieramy narzędzie, konfigurujemy skille, stawiamy MCP Tools pod wasze systemy — cały ekosystem, nie tylko IDE."
  heroImage="/img/sub/dla-zespolow.webp"
  heroAlt="Grupa oszronionych form ze wspólnym pomarańczowym rdzeniem"
>
  <!-- proof -->
  <ProofStrip items={[
    ['Cały ekosystem', 'narzędzia, skille i integracje, nie tylko IDE'],
    ['Mierzymy przed i po', 'twarde dane, nie wciskanie kitu'],
    ['3 do 50+ devów', 'od jednego sprintu po wewnętrznych championów'],
  ]} />

  <!-- 01 etapy -->
  <section class="sect" aria-labelledby="etapy">
    <div class="container">
      <SectHead eyebrow="01 / Współpraca · Jak to zwykle wygląda" title="Audyt → personalizacja → sprint → coaching ciągły." id="etapy" />
      <div class="steps">
        <article class="step rv"><p class="eyebrow">01 · Audyt AI · 1–2 dni</p><h3>Patrzymy, co was spowalnia</h3><p>Siadamy z waszym zespołem, patrzymy jak pracują na co dzień. Pytamy, co ich spowalnia, co ich wkurza. Zwykle po jednym dniu wiemy, gdzie jest największy potencjał. Efekt: raport stanu obecnego, mapa narzędzi i procesów, baseline KPI.</p></article>
        <article class="step rv" style="--rv-d:.08s"><p class="eyebrow">02 · Personalizacja · 1–2 dni</p><h3>Konfiguracja pod wasz stack</h3><p>Testujemy różne narzędzia na waszym kodzie — ale to dopiero początek. Konfigurujemy project rules, stawiamy MCP Tools pod wasze systemy, budujemy custom skille. Sam wybór narzędzia to 20% roboty. Efekt: dobór narzędzi, konfiguracja IDE, CLAUDE.md i project rules.</p></article>
        <article class="step rv" style="--rv-d:.16s"><p class="eyebrow">03 · Sprint treningowy · 2 tygodnie</p><h3>Robimy taski razem z AI</h3><p>Tu się dzieje magia. Bierzemy wasze prawdziwe taski i robimy je razem z AI. Devowie widzą na żywo, ile czasu oszczędzają. Po tygodniu większość nie chce wracać do starego sposobu. Efekt: coaching na waszych taskach, warsztat Context Engineering, setup MCP Tools.</p></article>
        <article class="step rv" style="--rv-d:.24s"><p class="eyebrow">04 · Coaching ciągły · stale</p><h3>Budujemy na fundamentach</h3><p>Sprawdzamy, czy coś się nie posypało, podsuwamy nowe tricki. Z doświadczenia — zespoły rosną najbardziej właśnie w tym etapie, bo już mają fundamenty. Efekt: tygodniowe review, nowe techniki i narzędzia, raport postępów.</p></article>
      </div>
    </div>
  </section>

  <!-- 02 narzędzia (ciemna) -->
  <section class="sect sect--dark" aria-labelledby="narzedzia">
    <div class="container">
      <SectHead eyebrow="02 / Narzędzia · Co trenujemy" title="Nie mamy jednego ulubionego. Testujemy i wybieramy to, co działa u was." id="narzedzia" />
      <dl class="def-rows rv">
        <div><dt>Agenci AI (Opus / Sonnet)<small>Core oferty</small></dt><dd>Rdzeń tego, co robimy. Opus i Sonnet od Anthropic to najlepsi agenci do kodu — rozumieją kontekst projektu, piszą produkcyjny kod, robią review. Wdrażamy ich w codzienną pracę zespołu.</dd></div>
        <div><dt>Claude Code<small>Mnożnik efektywności</small></dt><dd>Interfejs do uruchamiania agentów. Agent w terminalu — dajesz mu zadanie, odchodzisz po kawę, wracasz z gotowym PR-em. Tu Opus i Sonnet robią swoją robotę.</dd></div>
        <div><dt>MCP Tools<small>Znaczna różnica</small></dt><dd>Klej łączący agentów z waszymi systemami — GitHub, Jira, bazy danych, Slack. Agent nie jest już ślepy, widzi wasze dane i kontekst.</dd></div>
        <div><dt>Cursor / Copilot<small>Uzupełnienie</small></dt><dd>Narzędzia pomocnicze — sugestie inline, edycja wielu plików. Dobry start lub uzupełnienie agentów tam, gdzie potrzeba szybkiego podpowiadania w IDE.</dd></div>
      </dl>
    </div>
  </section>

  <!-- 03 FAQ -->
  <section class="sect" aria-labelledby="faq-title">
    <div class="container">
      <SectHead eyebrow="03 / FAQ · Pytania o program treningowy" title="Najczęstsze pytania przed startem." id="faq-title" small />
      <Faq items={faq} />
    </div>
  </section>

  <!-- kontakt CTA -->
  <CtaBand
    eyebrow="Kontakt"
    heading="Chcecie zobaczyć, jak to działa u was?"
    text="Pogadajmy 30 minut o waszym zespole. Zaczynamy od darmowego audytu AI — powiemy szczerze, czy warto."
    btnLabel="Umów darmowy audyt"
  />
</Interior>
