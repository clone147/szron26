---
import Strefa from '../../layouts/Strefa.astro';
---
<Strefa title="Sygnały" active="sygnaly">
  <div class="strefa-head">
    <div>
      <p class="strefa-eyebrow">Strefa zamknięta</p>
      <h1>Sygnały</h1>
      <p>Sygnały zakupowe CAIO: oferty pracy embedded/C++/AI i newsy z firm docelowych. Zasilane skanerem (<code>scripts/caio/scan.mjs</code>) — lokalnie lub przez routine.</p>
    </div>
  </div>

  <div class="strefa-stats" id="stats" aria-live="polite"></div>
  <div id="due"></div>

  <div class="strefa-toolbar">
    <div class="strefa-search">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
      <input class="strefa-input" id="search" type="search" placeholder="Szukaj firmy, stanowiska, słowa kluczowego…" autocomplete="off" />
    </div>
    <select class="strefa-input" id="f-typ" aria-label="Typ sygnału">
      <option value="">Wszystkie typy</option>
      <option value="praca">Oferty pracy</option>
      <option value="news">Newsy</option>
    </select>
    <select class="strefa-input" id="f-status" aria-label="Status">
      <option value="aktywne">Aktywne</option>
      <option value="nowy">Tylko nowe</option>
      <option value="odrzucony">Odrzucone</option>
      <option value="">Wszystkie</option>
    </select>
  </div>

  <div id="list" class="strefa-trainings"></div>
  <div id="empty" class="dgrid-empty" hidden>
    <p>Brak sygnałów dla wybranych filtrów. Skaner: <code>node scripts/caio/scan.mjs</code> (wymaga <code>CAIO_INGEST_SECRET</code>).</p>
  </div>

  <div id="modal-root"></div>
  <div class="strefa-toasts" id="toasts" aria-live="polite"></div>

  <style is:global>
    .syg-toggle { display: flex; align-items: center; gap: var(--space-md); flex: 1 1 auto; min-width: 0; background: transparent; border: 0; padding: 0; font: inherit; color: inherit; text-align: left; cursor: pointer; }
    .syg-tier { font-size: .68rem; font-weight: 600; text-transform: uppercase; letter-spacing: .06em; color: var(--color-text-inv-3); border: 1px solid var(--color-line-dark); border-radius: 999px; padding: .1rem .45rem; vertical-align: 2px; margin-left: .35rem; }
    .syg-tier--new { color: var(--color-accent); border-color: color-mix(in oklch, var(--color-accent) 45%, transparent); }
    .syg-body { display: flex; flex-direction: column; gap: 0; padding: .25rem .6rem; }
    .syg-row { display: flex; align-items: center; gap: .65rem; padding: .6rem .4rem; border-radius: var(--radius-sm); }
    .syg-row + .syg-row { border-top: 1px solid color-mix(in oklch, var(--color-line-dark) 55%, transparent); }
    .syg-row:hover { background: color-mix(in oklch, var(--color-ink-3) 55%, transparent); }
    .syg-row.is-dismissed { opacity: .5; }
    .syg-row.is-dismissed .syg-row__tytul { text-decoration: line-through; }
    .syg-row__waga { flex: none; width: 9px; height: 9px; border-radius: 50%; }
    .syg-row__waga--3 { background: oklch(60% 0.2 25); box-shadow: 0 0 0 3px color-mix(in oklch, oklch(60% 0.2 25) 22%, transparent); }
    .syg-row__waga--2 { background: oklch(72% 0.14 60); box-shadow: 0 0 0 3px color-mix(in oklch, oklch(72% 0.14 60) 22%, transparent); }
    .syg-row__waga--1 { background: var(--color-text-inv-3); }
    .syg-row__typ { flex: none; color: var(--color-text-inv-3); display: grid; place-content: center; }
    .syg-row__typ svg { width: 16px; height: 16px; }
    .syg-row__main { flex: 1 1 auto; min-width: 0; }
    .syg-row__tytul { color: var(--color-text-inv); font-weight: 500; text-decoration: none; display: inline-flex; align-items: center; gap: .3rem; }
    .syg-row__tytul svg { width: 12px; height: 12px; color: var(--color-text-inv-3); opacity: 0; transition: opacity var(--dur-1); }
    .syg-row:hover .syg-row__tytul svg { opacity: 1; }
    .syg-row__tytul:hover { color: var(--color-accent); }
    .syg-row__meta { display: flex; align-items: center; gap: .5rem; flex-wrap: wrap; margin-top: .25rem; color: var(--color-text-inv-3); font-size: var(--text-caption); }
    .syg-kw { font-size: .68rem; font-weight: 600; padding: .08rem .4rem; border-radius: 999px; background: var(--color-ink-3); color: var(--color-text-inv-2); }
    .syg-row__actions { flex: none; display: flex; gap: .2rem; opacity: 0; transition: opacity var(--dur-1); }
    .syg-row:hover .syg-row__actions, .syg-row:focus-within .syg-row__actions { opacity: 1; }
    @media (hover: none) { .syg-row__actions { opacity: 1; } }
    /* pasek „do dotknięcia dziś" */
    .syg-due { display: flex; align-items: center; gap: .5rem; flex-wrap: wrap; margin: var(--space-sm) 0; padding: .6rem .8rem; border: 1px solid color-mix(in oklch, var(--color-accent) 35%, var(--color-line-dark)); border-radius: var(--radius-sm); background: color-mix(in oklch, var(--color-accent) 7%, transparent); }
    .syg-due__lbl { display: inline-flex; align-items: center; gap: .4rem; font-weight: 600; font-size: var(--text-caption); color: var(--color-accent); }
    .syg-due__item { border: 1px solid var(--color-line-dark); background: var(--color-ink-2); border-radius: 999px; padding: .2rem .7rem; font-size: var(--text-caption); cursor: pointer; }
    .syg-due__item:hover { border-color: var(--color-accent); color: var(--color-accent); }
    .syg-due__item em { font-style: normal; color: var(--color-text-inv-3); }
    /* status pipeline w nagłówku firmy */
    .syg-status { width: auto; padding: .25rem 1.6rem .25rem .6rem; font-size: var(--text-caption); font-weight: 600; border-radius: 999px; cursor: pointer; }
    .syg-status--klient { color: oklch(52% 0.15 150); }
    .syg-status--rozmowa, .syg-status--propozycja { color: var(--color-accent); }
    .syg-status--odpadl { color: var(--color-text-inv-3); }
    /* historia dotyków */
    .syg-touches { margin-top: .5rem; padding: .5rem .4rem 0; border-top: 1px dashed var(--color-line-dark); }
    .syg-touches__lbl { font-size: .68rem; font-weight: 600; text-transform: uppercase; letter-spacing: .06em; color: var(--color-text-inv-3); margin-bottom: .3rem; }
    .syg-touch { display: flex; gap: .6rem; align-items: baseline; font-size: var(--text-caption); padding: .15rem 0; }
    .syg-touch__typ { font-weight: 600; }
    .syg-touch__date, .syg-touch__wynik { color: var(--color-text-inv-3); }
    /* chemia + kontakty + dossier */
    .syg-star { color: var(--color-text-inv-3); }
    .syg-star.is-on { color: var(--color-accent); }
    .syg-star.is-on svg { fill: var(--color-accent); }
    .syg-contact { display: flex; align-items: center; gap: .6rem; font-size: var(--text-caption); padding: .2rem 0; flex-wrap: wrap; }
    .syg-contact svg { color: var(--color-text-inv-3); }
    .syg-contact a { display: inline-flex; align-items: center; gap: .25rem; color: var(--color-accent); text-decoration: none; }
    .syg-contact a:hover { text-decoration: underline; }
    .syg-contact .strefa-iconbtn { margin-left: auto; }
    .syg-muted { color: var(--color-text-inv-3); font-size: var(--text-caption); margin: .2rem 0; }
    .syg-touches__lbl .strefa-btn { margin-left: .5rem; text-transform: none; letter-spacing: 0; }
    .syg-touches__lbl .syg-muted { font-weight: 400; text-transform: none; letter-spacing: 0; margin-left: .3rem; }
    .syg-dossier { font-size: var(--text-caption); line-height: 1.55; max-height: 24rem; overflow-y: auto; padding: .5rem .7rem; border: 1px solid var(--color-line-dark); border-radius: var(--radius-sm); background: color-mix(in oklch, var(--color-ink-3) 40%, transparent); }
    .syg-dossier h4, .syg-dossier h5 { margin: .6rem 0 .2rem; font-size: .78rem; text-transform: uppercase; letter-spacing: .05em; color: var(--color-text-inv-2); }
    .syg-dossier p { margin: .2rem 0; }
    .syg-dossier li { margin-left: 1rem; }
    .syg-form { display: grid; gap: .7rem; margin-bottom: var(--space-lg); }
    .syg-form label { display: grid; gap: .25rem; font-size: var(--text-caption); font-weight: 600; color: var(--color-text-inv-2); }
    /* modal sekwencji */
    .syg-seq { margin-bottom: var(--space-md); }
    .syg-seq.is-next { border-left: 3px solid var(--color-accent); padding-left: .7rem; }
    .syg-seq__head { display: flex; align-items: center; gap: .4rem; margin-bottom: .35rem; font-size: var(--text-caption); }
    .syg-seq__text { width: 100%; font-family: inherit; font-size: var(--text-caption); line-height: 1.5; resize: vertical; }
  </style>

  <script>
    import '../../lib/strefa-sygnaly.js';
  </script>
</Strefa>
