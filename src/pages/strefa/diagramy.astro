---
import Strefa from '../../layouts/Strefa.astro';
---
<Strefa title="Diagramy" active="diagramy">
  <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;600&display=swap" rel="stylesheet" />

  <div id="diag-gallery">
    <div class="strefa-head">
      <div>
        <p class="strefa-eyebrow">Strefa zamknięta · Diagramy</p>
        <h1>Diagramy</h1>
      </div>
      <button class="strefa-btn strefa-btn--ghost strefa-btn--sm" id="btn-import" type="button">Import z JSON</button>
    </div>
    <div class="diag-grid" id="diag-grid"></div>
  </div>

  <div class="diag-wrap" id="diag-editor" hidden>
    <div class="diag-bar">
      <div class="diag-bar__group">
        <button class="strefa-iconbtn" id="btn-back" type="button" title="Wróć do galerii diagramów" aria-label="Wróć do galerii diagramów"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5m7-7-7 7 7 7"/></svg></button>
        <span class="diag-title" id="diag-title"></span>
        <button class="strefa-iconbtn" id="btn-rename" type="button" title="Zmień nazwę"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg></button>
        <button class="strefa-iconbtn" id="btn-delete" type="button" title="Usuń diagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/></svg></button>
        <button class="strefa-iconbtn" id="btn-prev" type="button" title="Poprzedni diagram (←)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg></button>
        <button class="strefa-iconbtn" id="btn-next" type="button" title="Następny diagram (→)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg></button>
        <button class="strefa-iconbtn" id="btn-lock" type="button" title="Zablokuj edycję" aria-pressed="false"></button>
        <button class="strefa-iconbtn" id="btn-play" type="button" title="Odtwórz diagram (spacja = krok, klik = zoom na obiekt)" aria-pressed="false"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 4.5v15l13-7.5Z"/></svg></button>
        <button class="strefa-iconbtn" id="btn-pres" type="button" title="Tryb prezentacji — kamera prowadzi po diagramie krok po kroku (P)" aria-pressed="false"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h20"/><path d="M21 3v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V3"/><path d="m7 21 5-5 5 5"/></svg></button>
        <span class="diag-hint" id="play-hint" hidden>spacja — następny krok · ← — krok wstecz · klik — zoom na obiekt · klik w tło / „−” — powrót · Esc — koniec</span>
      </div>
      <div class="diag-bar__group diag-tools diag-zoom" role="toolbar" aria-label="Zoom">
        <button class="diag-tool" id="btn-zoom-out" type="button" title="Oddal"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14"/></svg></button>
        <button class="diag-tool diag-zoom__pct" id="btn-zoom-100" type="button" title="Resetuj zoom (100%)">100%</button>
        <button class="diag-tool" id="btn-zoom-in" type="button" title="Przybliż"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg></button>
      </div>
      <div class="diag-bar__group diag-tools" role="toolbar" aria-label="Narzędzia">
        <button class="diag-tool" data-tool="select" type="button" title="Zaznaczanie (V)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m4 3 7.5 18 2.6-7.9L22 10.5Z"/></svg></button>
        <button class="diag-tool" data-tool="rect" type="button" title="Prostokąt (R)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><rect x="4" y="6" width="16" height="12" rx="1"/></svg></button>
        <button class="diag-tool" data-tool="arrow" type="button" title="Strzałka (A)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 19 19 5"/><path d="M10 5h9v9"/></svg></button>
        <button class="diag-tool" data-tool="text" type="button" title="Tekst (T)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7V5h16v2M12 5v14M9 19h6"/></svg></button>
        <button class="diag-tool" id="btn-icons" type="button" title="Ikony (I)" aria-pressed="false"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="9" cy="10" r="1.6"/><path d="m5 18 5-5 3 3 3.5-3.5L21 17"/></svg></button>
        <button class="diag-tool" id="btn-images" type="button" title="Szukaj obrazków (G)" aria-pressed="false"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/><path d="M7.5 13.5 10 11l2 2 2-2.5 2.5 3"/></svg></button>
        <button class="diag-tool" id="btn-koboyo" type="button" title="Biblioteka Koboyo (K)" aria-pressed="false"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19c2-6 5-13 8-13s2 6 5 6 3-3 3-3"/><path d="M4 8c1.5 0 1.5 2 3 2s1.5-2 3-2"/></svg></button>
      </div>
    </div>
    <div class="diag-canvas-wrap" id="canvas-wrap">
      <canvas id="diag-canvas"></canvas>
      <textarea id="diag-text" class="diag-textedit" hidden spellcheck="false"></textarea>
      <div class="diag-icons" id="icon-panel" hidden role="listbox" aria-label="Biblioteka ikon doodle"></div>
      <div class="diag-imgsearch" id="img-panel" hidden aria-label="Wyszukiwarka obrazków">
        <div class="diag-imgsearch__head">
          <span class="diag-imgsearch__eyebrow">Obrazki</span>
          <button class="diag-imgsearch__url" id="img-url" type="button" title="Wstaw obrazek z adresu URL">Wklej adres</button>
        </div>
        <input class="diag-imgsearch__input" id="img-q" type="search" placeholder="Szukaj obrazka — np. „docker logo”" autocomplete="off" spellcheck="false" />
        <div class="diag-imgsearch__tabs" id="img-tabs" role="tablist"></div>
        <p class="diag-imgsearch__note" id="img-note"></p>
        <div class="diag-imgsearch__grid" id="img-results" role="listbox"></div>
      </div>
      <div class="diag-imgsearch diag-koboyo" id="koboyo-panel" hidden aria-label="Biblioteka ikon Koboyo">
        <div class="diag-imgsearch__head">
          <span class="diag-imgsearch__eyebrow">Koboyo — rysunkowe ikony</span>
          <a class="diag-imgsearch__url" href="https://koboyo.com/icons" target="_blank" rel="noreferrer" title="Źródło: koboyo.com/icons">koboyo.com</a>
        </div>
        <input class="diag-imgsearch__input" id="kb-q" type="search" placeholder="Filtruj — np. „server”, „robot”, „meeting” (po angielsku)" autocomplete="off" spellcheck="false" />
        <div class="diag-imgsearch__tabs" id="kb-tabs" role="tablist"></div>
        <p class="diag-imgsearch__note" id="kb-note"></p>
        <div class="diag-imgsearch__grid diag-koboyo__grid" id="kb-grid" role="listbox"></div>
      </div>
      <div class="diag-pres" id="pres-ui" hidden aria-hidden="true">
        <span class="diag-pres__title" id="pres-title"></span>
        <span class="diag-pres__counter" id="pres-counter"></span>
        <span class="diag-pres__hint">spacja — dalej · ← — wstecz · O — cała mapa · klik w obiekt — skok · Esc — koniec</span>
      </div>
      <div class="diag-fx" id="fx-panel" hidden role="toolbar" aria-label="Animacja elementu">
        <span class="diag-fx__label">Animacja</span>
        <div class="diag-fx__chips">
          <button class="diag-fx__chip" data-fx="draw" type="button" title="Element rysuje się jak ręką (domyślne)">Rysowanie</button>
          <button class="diag-fx__chip" data-fx="pop" type="button" title="Wskakuje ze sprężystym przeskalowaniem">Pop</button>
          <button class="diag-fx__chip" data-fx="slide" type="button" title="Wjeżdża z boku z zanikiem">Wjazd</button>
          <button class="diag-fx__chip" data-fx="count" type="button" title="Liczba w tekście odlicza od zera">Licznik</button>
        </div>
        <button class="diag-fx__chip diag-fx__pulse" id="fx-pulse" type="button" title="Po wejściu element pulsuje kolorem akcentu">Puls</button>
        <button class="diag-fx__chip diag-fx__pulse" id="fx-tint" type="button" hidden title="Maluje grafikę kolorem kreski — ratunek dla czarnych logotypów na ciemnym tle">Barw tuszem</button>
      </div>
    </div>
  </div>

  <div id="modal-root"></div>
  <div class="strefa-toasts" id="toasts" aria-live="polite"></div>

  <script>
    import '../../lib/strefa-diagramy.js';
  </script>
</Strefa>
