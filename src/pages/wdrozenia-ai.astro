---
import Interior from '../layouts/Interior.astro';
import SectHead from '../components/SectHead.astro';
import ProofStrip from '../components/ProofStrip.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';

// FAQ — numeracja 01…NN generowana w <Faq />
const faq = [
  { q: 'Na czyim kodzie pracujemy podczas warsztatu?', a: 'Na waszym — bierzemy realne taski z Jiry i robimy je razem z AI, nie na sztucznych przykładach. Dzięki temu efekty widać od pierwszego tygodnia, a zespół od razu uczy się pracy na własnym projekcie.' },
  { q: 'Co zostaje u nas po zakończeniu programu?', a: 'Skonfigurowane narzędzia, dokumentacja procesów i 30 dni wsparcia. Celem jest autonomia — żebyście jechali dalej bez nas. Agent AI działa wtedy jak drugi mózg programisty.' },
  { q: 'Czy kod musi wychodzić na zewnątrz?', a: 'Nie musi. Tam, gdzie to ważne, stawiamy lokalne modele AI w waszej serwerowni — pełna kontrola nad danymi, zgodność z NIS2 i wymaganiami branżowymi, a skuteczność porównywalna z modelami w chmurze.' },
];
---
<Interior
  title="Wdrożenia AI — mierzalne efekty treningu | SZRON"
  description="Co dostajecie z treningu AI: szybsze kodowanie na waszym kodzie i taskach, mierzalne efekty od pierwszego tygodnia, narzędzia i dokumentacja, które zostają."
  eyebrow="Coaching Sprint · efekty od pierwszego tygodnia"
  heading="Co konkretnie dostaniecie z treningu AI."
  lead="Wasi programiści uczą się pracować z AI na waszym kodzie, na waszych taskach — z mierzalnymi efektami od pierwszego tygodnia. Pokazujemy, co realnie pomaga, zostawiamy skonfigurowane narzędzia i dokumentację, a celem jest, żebyście jechali dalej bez nas."
  heroImage="/img/sub/wdrozenia-ai.webp"
  heroAlt="Zazębiające się oszronione koła zębate z pomarańczową energią"
>
  <!-- proof -->
  <ProofStrip items={[
    ['Na waszym kodzie', 'nie na przykładach — efekty od pierwszego tygodnia'],
    ['25+ lat doświadczenia', '3+ lata z LLM: RAG, fine-tuning'],
    ['30 dni wsparcia', 'i autonomia zespołu po programie'],
  ]} />

  <!-- 01 co mówią -->
  <section class="sect" aria-labelledby="opinie">
    <div class="container">
      <SectHead eyebrow="01 / Dowód · Co to zmienia w pracy zespołu" title="Jeden dev z AI bierze na siebie pracę, która kiedyś wymagała całego zespołu." id="opinie" small />
      <img class="hero-img rv" src="/img/sub/wdrozenia-ai-warsztat.webp" alt="Inżynier z tabletem z metrykami produkcji w jasnej hali przemysłowej" width="1380" height="768" loading="lazy" />
      <div class="grid-cards">
        <figure class="quote-card rv">
          <blockquote>„Jeden zaawansowany we współpracy z AI pracownik jest w stanie wykonać zadania, które wcześniej wymagały pracy kilkudziesięcioosobowego zespołu."</blockquote>
          <figcaption><strong>The New York Times</strong> — maj 2025</figcaption>
        </figure>
        <article class="card-tile rv" style="--rv-d:.1s">
          <p class="eyebrow">Skąd to wiemy</p>
          <h3>Z realnych projektów, nie z obietnic.</h3>
          <p>Pracowaliśmy z AI na produkcyjnym kodzie w różnych branżach: fintech, IoT, embedded, mobile, e-commerce. Poniżej konkretne projekty i konkretne liczby.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- 02 case studies (ciemna) -->
  <section class="sect sect--dark" aria-labelledby="rezultaty">
    <div class="container">
      <SectHead eyebrow="02 / Rezultaty · Prawdziwe projekty z AI" title="Jakie rezultaty daje trening AI. Konkretne liczby, nie obietnice." id="rezultaty" />
      <div class="grid-cards">
        <article class="card-tile rv">
          <p class="eyebrow">01 / System raportowania</p>
          <h3>3x szybsze raporty</h3>
          <p>Python, Pandas i OpenAI API. Tydzień zamiast miesiąca pracy analityka — 3x szybsze generowanie raportów i przyspieszenie pracy analitycznej.</p>
        </article>
        <article class="card-tile rv" style="--rv-d:.08s">
          <p class="eyebrow">02 / Integracja API</p>
          <h3>5–7x szybsze wdrożenie</h3>
          <p>REST API i webhooki z obsługą błędów, komplet testów jednostkowych i integracyjnych. 2–3 dni zamiast tygodni — gotowe do produkcji.</p>
        </article>
        <article class="card-tile rv" style="--rv-d:.16s">
          <p class="eyebrow">03 / Aplikacje mobilne</p>
          <h3>2 platformy w czasie jednej</h3>
          <p>React Native: iOS i Android jednocześnie, gotowe pod App Store i Google Play. Dni zamiast miesięcy developmentu, z natywną wydajnością.</p>
        </article>
        <article class="card-tile rv" style="--rv-d:.24s">
          <p class="eyebrow">04 / Drukarka RS232 (embedded)</p>
          <h3>20x szybciej</h3>
          <p>Rust i systemy embedded (ARM Cortex): teksty, grafika BMP i kody QR. 1,5 dnia zamiast miesiąca — w produkcji w kasach POS na Litwie.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- 03 jak pracujemy -->
  <section class="sect" aria-labelledby="proces">
    <div class="container">
      <SectHead eyebrow="03 / Proces · Jak pracujemy z Waszym zespołem" title="Jak to wygląda z perspektywy Waszego zespołu." id="proces" />
      <div class="steps">
        <article class="step rv"><p class="eyebrow">01 · Diagnoza</p><h3>Sprawdzamy, co Was spowalnia</h3><p>Patrzymy na wasze daily, review i pipeline. Pytamy devów, co ich wkurza. Zwykle po jednym dniu wiemy, gdzie jest problem.</p></article>
        <article class="step rv" style="--rv-d:.08s"><p class="eyebrow">02 · Dobór narzędzi</p><h3>Szukamy najlepszego narzędzia</h3><p>Testujemy na waszym kodzie i wybieramy to, co realnie pomaga: GitHub Copilot, agenci AI, ChatGPT / GPT-4, Cursor IDE.</p></article>
        <article class="step rv" style="--rv-d:.16s"><p class="eyebrow">03 · Warsztat</p><h3>Na waszym kodzie</h3><p>Bierzemy wasze taski z Jiry i robimy je razem z AI: Context Engineering, Self-Improving Loops, integracja MCP Tools, konfiguracja AGENTS.md.</p></article>
        <article class="step rv" style="--rv-d:.24s"><p class="eyebrow">04 · Oddajemy klucze</p><h3>Jedziecie dalej bez nas</h3><p>Zostawiamy skonfigurowane narzędzia, dokumentację i 30 dni wsparcia. Cel jest prosty — żebyście jechali dalej bez nas.</p></article>
      </div>
    </div>
  </section>

  <!-- 04 dlaczego SZRON (ciemna) -->
  <section class="sect sect--dark" aria-labelledby="dlaczego">
    <div class="container">
      <SectHead eyebrow="04 / Dlaczego SZRON · Co robi różnicę" title="Różnicę robi podejście. Dlatego zespoły wybierają nas." id="dlaczego" />
      <dl class="def-rows rv">
        <div><dt>Budujemy wasze kompetencje<small>Autonomia po 30 dniach</small></dt><dd>Długoterminowe partnerstwo: wasz zespół rośnie, a my wracamy regularnie z nowymi narzędziami i strategiami. Agent AI jako drugi mózg programisty, pełna dokumentacja procesów.</dd></div>
        <div><dt>Doświadczenie z wielu branż<small>Wzorce, które działają</small></dt><dd>Fintech, IoT, embedded, mobile, e-commerce — od embedded po web. Dzięki temu widzimy wzorce, które działają niezależnie od branży, i te, które inni przegapiają.</dd></div>
        <div><dt>Lokalne modele AI<small>Kod nie musi wychodzić na zewnątrz</small></dt><dd>Stawiamy lokalne modele w waszej serwerowni — pełna kontrola nad danymi. Zgodność z NIS2, wsparcie dla wymagań branżowych, skuteczność porównywalna z agentami w chmurze.</dd></div>
        <div><dt>Context Engineering<small>Prompt engineering to już za mało</small></dt><dd>Uczymy zespoły personalizować agentów AI pod ich projekty — to robi prawdziwą różnicę. Self-Improving Loops i spersonalizowany agent zamiast pojedynczych promptów.</dd></div>
      </dl>
    </div>
  </section>

  <!-- 05 FAQ -->
  <section class="sect" aria-labelledby="faq-title">
    <div class="container">
      <SectHead eyebrow="05 / FAQ · Zanim zaczniemy" title="Pytania, które padają przed treningiem." id="faq-title" small />
      <Faq items={faq} />
    </div>
  </section>

  <!-- kontakt CTA -->
  <CtaBand
    eyebrow="Kontakt"
    heading="Chcecie zobaczyć różnicę? 30 minut, zero sprzedaży."
    text="Porozmawiajmy o waszym zespole — powiemy wprost, co ma sens, a co nie. Praktyka na waszym kodzie, budowanie kompetencji AI w zespole, widoczna zmiana w pierwszych tygodniach."
    btnLabel="Umów Coaching Sprint"
  />
</Interior>
