---
import Interior from '../layouts/Interior.astro';
import SectHead from '../components/SectHead.astro';
import ProofStrip from '../components/ProofStrip.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';

// FAQ — numeracja 01…NN generowana w <Faq />; pole a = surowy HTML (set:html)
const faq = [
  { q: 'Jak zmierzymy efekt?', a: 'DORA metrics jako baseline w tygodniu 1: czas od ticketu do PR, czas merge, bug escape rate, pokrycie testami. Mierzymy ponownie w tygodniu 12. Raport ROI dla zarządu — dashboard z twardymi liczbami.' },
  { q: 'Co z bezpieczeństwem naszych danych?', a: 'Wasz kod nie idzie do publicznych modeli. Dla branż regulowanych — Bedrock w AWS, dane w Waszej VPC. Dla obronności i wrażliwego embedded — lokalne modele (Ollama, vLLM) na Waszych serwerach. Audit log każdej interakcji z AI. NDA podpisujemy przed pierwszą rozmową.' },
  { q: 'Co jeśli zespół nie kupi tej zmiany?', a: 'Najczęstszy opór to nie technologia, tylko obawa: „jak się zautomatyzuję, będę niepotrzebny”. Rozbrajamy ją na liczbach — programista prowadzący agenta dostarcza kilka razy więcej, więc jego wartość rośnie, nie maleje. Trening prowadzimy na ich kodzie, pierwsze dostawy w drugim tygodniu. A jeśli zespół się nie przekonuje — wstrzymujemy modernizację i wracamy do diagnozy. Bez wstydu, bez kar.' },
  { q: 'Czy stara aplikacja będzie działać w trakcie?', a: 'Tak. Pilot wchodzi obok: dwa systemy równolegle, moduł po module, testy regresyjne na danych z produkcji. Wasza baza danych zostaje bez zmian.' },
];
---
<Interior
  title="AI dla zespołów software — workflow agentowy | SZRON"
  description="Jak zmienia się codzienna praca programisty z agentem AI: plan mode, subagenci, MCP servery, AGENTS.md jako kontrakt. Efekt mierzony DORA i DEVLens."
  eyebrow="Dla zespołów software · codzienny workflow"
  heading="Tak wygląda dzień programisty, który prowadzi agenta."
  lead="Najbardziej operacyjna z naszych stron. Pokazujemy, jak konkretnie zmienia się codzienna praca, jakich narzędzi używamy i jak mierzymy efekt od pierwszego tygodnia."
  heroImage="/img/sub/ai-dla-dev-teamow.webp"
  heroAlt="Sieć oszronionych węzłów połączonych pomarańczowymi liniami"
>
  <!-- 01 wczoraj → dziś -->
  <section class="sect" aria-labelledby="wczoraj-dzis">
    <div class="container">
      <SectHead eyebrow="01 / Codzienna praca · Wczoraj a dziś" title="Co zmienia się w pracy dewa, gdy dochodzi agent." id="wczoraj-dzis" small />
      <img class="hero-img rv" src="/img/sub/ai-dla-dev-teamow-para.webp" alt="Maciej programuje w parze z programistą przy monitorze z panelem asystenta AI" width="1380" height="768" loading="lazy" />
      <table class="results-table rv">
        <thead><tr><th scope="col">Czynność</th><th scope="col">Wczoraj — wspomaganie</th><th scope="col">Dziś — programowanie intencyjne</th></tr></thead>
        <tbody>
          <tr>
            <td>Nowy task</td>
            <td>Czytasz ticket, sam piszesz kod linijka po linijce, autouzupełnianie podpowiada fragmenty.</td>
            <td><strong>Zlecasz agentowi intencję, kontekst i kryteria odbioru — i oceniasz wynik.</strong></td>
          </tr>
          <tr>
            <td>Debug i legacy</td>
            <td>Szukanie błędu w nieznanym kodzie zjada dni, zanim w ogóle ruszysz z poprawką.</td>
            <td><strong>Agent czyta repo z kontekstem, lokalizuje problem i proponuje fix do oceny.</strong></td>
          </tr>
          <tr>
            <td>Testy</td>
            <td>Pisane po fakcie albo wcale — backlog rośnie szybciej niż pokrycie.</td>
            <td><strong>Średnia 3–4 mergowane PR-y dziennie, każdy z testami.</strong></td>
          </tr>
          <tr>
            <td>Standard zespołu</td>
            <td>Tech lead pilnuje konwencji ręcznie, w code review — i staje się wąskim gardłem.</td>
            <td><strong>AGENTS.md / CLAUDE.md to kontrakt: zasady i kryteria odbioru wykonuje agent.</strong></td>
          </tr>
          <tr>
            <td>Pierwsze dostawy</td>
            <td>Onboarding i nowy moduł liczone w miesiącach.</td>
            <td><strong>Pierwsze realne dostawy w drugim tygodniu, na Waszym kodzie.</strong></td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- 02 pełny workflow agentowy (ciemna) -->
  <section class="sect sect--dark" aria-labelledby="workflow">
    <div class="container">
      <SectHead eyebrow="02 / Workflow · Jak prowadzi się agenta" title="Pełny workflow agentowy zamiast czatu z promptami." id="workflow" />
      <dl class="def-rows rv">
        <div>
          <dt>Plan mode<small>najpierw plan, potem kod</small></dt>
          <dd>Agent najpierw rozpisuje plan na zadanie — intencję, kontekst, kryteria odbioru — który programista ocenia, zanim cokolwiek się zmieni w repo.</dd>
        </div>
        <div>
          <dt>Subagenci<small>podział złożonego taska</small></dt>
          <dd>Złożone zadania dzielą się na wyspecjalizowane przebiegi, które pracują równolegle i wracają z wynikiem do oceny.</dd>
        </div>
        <div>
          <dt>MCP servery<small>połączenie wprost z Waszym kontekstem</small></dt>
          <dd>MCP servery pisane pod projekt łączą agenta wprost z Waszą bazą danych (MS SQL, MySQL, IBM DB2, Postgres, Oracle) i narzędziami zespołu.</dd>
        </div>
        <div>
          <dt>AGENTS.md / CLAUDE.md<small>kontrakt zespołu</small></dt>
          <dd>Konstytucja zespołu: zasady, konwencje i kryteria odbioru zapisane raz, egzekwowane przez agenta przy każdym tasku. Zostaje u Was jako powielalny wzorzec.</dd>
        </div>
        <div>
          <dt>Wspólny commit<small>na żywym kodzie</small></dt>
          <dd>Uczymy przez wspólne sesje na Waszym kodzie. Każdy programista pracuje samodzielnie po kilku spotkaniach.</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- 03 pomiar -->
  <section class="sect" aria-labelledby="pomiar">
    <div class="container">
      <SectHead eyebrow="03 / Pomiar · DORA i DEVLens" title="Efekt w danych, nie w deklaracjach." id="pomiar" small />
      <ProofStrip wrap={false} items={[
        ['Tydzień 1', 'baseline DORA: czas od ticketu do PR, czas merge, bug escape rate, pokrycie testami'],
        ['DEVLens', 'wskaźniki produktywności wprost z repozytoriów Git i SVN, od pierwszego tygodnia'],
        ['Tydzień 12', 'pomiar ponowny i raport ROI dla zarządu — dashboard z liczbami'],
      ]} />
      <p class="rv" style="--rv-d:.1s; margin-top:var(--space-lg); max-width:60ch">
        Baseline zakładamy w tygodniu 1, mierzymy ponownie w tygodniu 12 — porównujemy te same wskaźniki, a nie wrażenia. To, co zajmowało 6 miesięcy, zespół dostarcza w 4 tygodnie; tempo rośnie 2–4 razy. Średnia po naszych projektach to 3–4 mergowane PR-y dziennie na programistę, każdy z testami.
      </p>
    </div>
  </section>

  <!-- 04 dokąd dalej -->
  <section class="sect" aria-labelledby="dalej" style="padding-top:0">
    <div class="container">
      <SectHead eyebrow="04 / Dokąd dalej · Powiązane" title="Gdzie zajrzeć po szczegóły." id="dalej" small />
      <div class="link-cards rv">
        <a class="link-card" href="/metoda">
          <h3>Metoda</h3>
          <p>Trzy ścieżki w dwóch kwartałach: trening AI, agentowe programowanie i pilot modernizacji. Jak prowadzimy zmianę krok po kroku.</p>
        </a>
        <a class="link-card" href="/akademia">
          <h3>Akademia</h3>
          <p>Szkolenia i materiały o codziennej pracy z agentem — plan mode, subagenci, skille, MCP. Wiedza, na której opieramy workflow.</p>
        </a>
        <a class="link-card" href="/case-studies">
          <h3>Case studies</h3>
          <p>Efekty wdrożeń pokazane na danych z repozytoriów. Co zostaje po nas: działający system, samodzielny programista i powielalny wzorzec.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- 05 FAQ -->
  <section class="sect" aria-labelledby="faq-title" style="padding-top:0">
    <div class="container">
      <SectHead eyebrow="05 / FAQ · Pytania o pracę z agentem" title="Pytania, które padają przed startem." id="faq-title" small />
      <Faq items={faq} />
    </div>
  </section>

  <!-- kontakt CTA -->
  <CtaBand
    eyebrow="Kontakt"
    heading="Zobaczcie ten workflow na własnym kodzie."
    text="30 minut rozmowy. Powiemy, czy i gdzie agent da Waszemu zespołowi realny zwrot — i jak go zmierzymy od pierwszego tygodnia."
    btnLabel="Umów diagnozę"
  />
</Interior>
