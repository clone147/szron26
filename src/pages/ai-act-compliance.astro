---
import Interior from '../layouts/Interior.astro';
import SectHead from '../components/SectHead.astro';
import ProofStrip from '../components/ProofStrip.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';

// FAQ — numeracja 01…NN generowana w <Faq />; pole a = surowy HTML (set:html)
const faq = [
  { q: 'Czy AI Act dotyczy mojej firmy?', a: 'Jeśli wdrażasz lub używasz systemów AI w UE — prawdopodobnie tak. Nawet jeśli nie jesteś dostawcą AI, jako użytkownik (deployer) masz określone obowiązki.' },
  { q: 'Jakie są kary za nieprzestrzeganie?', a: 'Do 35 mln EUR lub 7 procent globalnych przychodów za najcięższe naruszenia. Mniejsze naruszenia: do 15 mln EUR lub 3 procent przychodów.' },
  { q: 'Czy ChatGPT lub Copilot to system high-risk?', a: 'Modele ogólnego przeznaczenia (GPAI) mają oddzielne wymagania. Jeśli jednak używasz ich w kontekście high-risk — na przykład w HR lub finansach — cały system może zostać sklasyfikowany jako high-risk.' },
  { q: 'Od czego zacząć przygotowania?', a: 'Po kolei: inwentaryzacja systemów AI, klasyfikacja ryzyka, gap analysis, plan wdrożenia. Przy audycie przeprowadzamy Cię przez każdy z tych kroków.' },
];
---
<Interior
  title="AI Act 2026 — czy Twoja firma jest gotowa? | SZRON"
  description="Sprawdź, czy Twoja firma musi dostosować się do AI Act. Kluczowe daty, klasyfikacja ryzyka, kary i checklist zgodności dla polskich firm."
  eyebrow="Regulacje UE · AI Act"
  updated="2026-07-04"
  heading="AI Act 2026. Terminy właśnie się zmieniły."
  lead="29 czerwca 2026 Rada UE zatwierdziła pakiet upraszczający AI Act i przesunęła wymogi high-risk o 16 miesięcy — na 2 grudnia 2027. W Polsce przeszło to bez echa. Obowiązki transparentności wchodzą jednak już w sierpniu 2026, a oznaczanie treści AI — 2 grudnia 2026. Poniżej aktualny terminarz, klasyfikacja ryzyka i od czego zacząć."
  heroImage="/img/sub/ai-act-compliance.webp"
  heroAlt="Oszroniony dokument z lodu z pomarańczową pieczęcią"
>
  <!-- proof -->
  <ProofStrip items={[
    ['+16 miesięcy', 'high-risk przesunięty na 2 grudnia 2027'],
    ['Do 35 mln EUR', 'kary za najcięższe naruszenia'],
    ['Sierpień 2026', 'transparentność chatbotów i agentów — już'],
  ]} />

  <!-- 01 kluczowe daty (ciemna) -->
  <section class="sect sect--dark" aria-labelledby="daty">
    <div class="container">
      <SectHead eyebrow="01 / Timeline · Terminarz po zmianach z 29.06.2026" title="Aktualny terminarz. Dwie daty bliżej, niż myślisz." id="daty">
        <p class="sect-lead rv">Kancelarie piszą o tych zmianach dla zarządów. My tłumaczymy, co z tego wynika dla CTO i tech leadów: 16 miesięcy oddechu na high-risk to czas na wdrożenie z governance, nie na odkładanie. A transparentność i oznaczanie treści wchodzą praktycznie zaraz.</p>
      </SectHead>
      <img class="hero-img rv" src="/img/sub/ai-act-checklista.webp" alt="Tomek analizuje wydrukowaną checklistę zgodności, za oknem flaga Unii Europejskiej" width="1380" height="768" loading="lazy" />
      <table class="results-table rv">
        <thead><tr><th scope="col">Data</th><th scope="col">Co wchodzi w życie</th><th scope="col">Co to znaczy w praktyce</th></tr></thead>
        <tbody>
          <tr><td>2 lutego 2025</td><td>Zakaz praktyk AI o niedopuszczalnym ryzyku</td><td><strong>Manipulacja, social scoring, rozpoznawanie emocji w pracy — obowiązuje</strong></td></tr>
          <tr><td>2 sierpnia 2025</td><td>Obowiązki dla modeli GPAI</td><td><strong>Dokumentacja techniczna, transparentność, prawa autorskie — obowiązuje</strong></td></tr>
          <tr><td>Sierpień 2026</td><td>Obowiązki transparentności</td><td><strong>Chatboty i agenci muszą się ujawniać — zinwentaryzuj, kto ma AI w produkcie, teraz</strong></td></tr>
          <tr><td>2 grudnia 2026</td><td>Oznaczanie treści generowanych przez AI</td><td><strong>Odroczone tylko o 4 miesiące — dotyczy każdego, kto publikuje content z AI</strong></td></tr>
          <tr><td>2 grudnia 2027</td><td>High-risk, Annex III (przesunięte z 2.08.2026)</td><td><strong>Systemy HR, kredytowe, edukacyjne, infrastruktura krytyczna</strong></td></tr>
          <tr><td>2 sierpnia 2028</td><td>Annex I — AI w produktach regulowanych</td><td><strong>Obronność, energetyka, medtech</strong></td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- 02 czy to dotyczy mojej firmy -->
  <section class="sect" aria-labelledby="dotyczy">
    <div class="container">
      <SectHead eyebrow="02 / Zakres · Czy to dotyczy mojej firmy" title="Tak, jeśli spełniasz którykolwiek z tych warunków." id="dotyczy" small>
        <p class="sect-lead rv">Zaznacz w myślach pasujące punkty. Jeśli pasuje choćby jeden — AI Act najprawdopodobniej Cię dotyczy.</p>
      </SectHead>
      <div class="grid-cards">
        <article class="card-tile rv">
          <p class="eyebrow">a</p>
          <h3>AI w procesach HR</h3>
          <p>Używasz AI w rekrutacji lub ocenie pracowników.</p>
        </article>
        <article class="card-tile rv" style="--rv-d:.06s">
          <p class="eyebrow">b</p>
          <h3>Chatbot obsługi klienta</h3>
          <p>Masz chatbota obsługującego klientów.</p>
        </article>
        <article class="card-tile rv" style="--rv-d:.12s">
          <p class="eyebrow">c</p>
          <h3>Scoring i ocena ryzyka</h3>
          <p>Korzystasz z AI do scoringu kredytowego lub oceny ryzyka.</p>
        </article>
        <article class="card-tile rv" style="--rv-d:.18s">
          <p class="eyebrow">d</p>
          <h3>Decyzje wpływające na ludzi</h3>
          <p>Automatyzujesz decyzje, które wpływają na ludzi.</p>
        </article>
        <article class="card-tile rv" style="--rv-d:.24s">
          <p class="eyebrow">e</p>
          <h3>AI w edukacji i szkoleniach</h3>
          <p>Używasz AI w edukacji lub szkoleniach.</p>
        </article>
        <article class="card-tile rv" style="--rv-d:.3s">
          <p class="eyebrow">f</p>
          <h3>Rozpoznawanie biometryczne</h3>
          <p>Stosujesz rozpoznawanie biometryczne.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- 03 od czego zacząć (ciemna) -->
  <section class="sect sect--dark" aria-labelledby="kroki">
    <div class="container">
      <SectHead eyebrow="03 / Przygotowanie · Od czego zacząć" title="Cztery kroki do gotowości na AI Act." id="kroki" />
      <div class="steps">
        <article class="step rv"><p class="eyebrow">01 · Inwentaryzacja</p><h3>Spis systemów AI</h3><p>Zbierz wszystkie systemy AI, które wdrażasz lub z których korzystasz.</p></article>
        <article class="step rv" style="--rv-d:.08s"><p class="eyebrow">02 · Klasyfikacja</p><h3>Ocena ryzyka</h3><p>Przypisz każdy system do kategorii: prohibited, high-risk, limited, minimal.</p></article>
        <article class="step rv" style="--rv-d:.16s"><p class="eyebrow">03 · Gap analysis</p><h3>Luka do zamknięcia</h3><p>Porównaj stan obecny z wymogami i wskaż, czego brakuje.</p></article>
        <article class="step rv" style="--rv-d:.24s"><p class="eyebrow">04 · Plan wdrożenia</p><h3>Harmonogram działań</h3><p>Najpierw transparentność (sierpień 2026) i oznaczanie treści (grudzień 2026), potem high-risk — do grudnia 2027.</p></article>
      </div>
    </div>
  </section>

  <!-- 04 FAQ -->
  <section class="sect" aria-labelledby="faq-title">
    <div class="container">
      <SectHead eyebrow="04 / FAQ · Najczęstsze pytania o AI Act" title="Pytania, które padają najczęściej." id="faq-title" small />
      <Faq items={faq} />
    </div>
  </section>

  <!-- kontakt CTA -->
  <CtaBand
    eyebrow="Kontakt"
    heading="Potrzebujesz pomocy z AI Act?"
    text="Pomożemy przygotować firmę na nowe regulacje: audyt zgodności, gap analysis i plan wdrożenia. Umówmy rozmowę i ustalmy, na czym stoisz."
    btnLabel="Umów audyt zgodności"
  />
</Interior>
