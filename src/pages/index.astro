---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import SectHead from '../components/SectHead.astro';
import Faq from '../components/Faq.astro';
import BtnArrow from '../components/BtnArrow.astro';

// FAQ — numeracja 01…NN generowana w <Faq />; pole a = surowy HTML (set:html), stąd np. T&amp;M
const faq = [
  { q: 'Co z bezpieczeństwem naszych danych?', a: 'Wasz kod nie idzie do publicznych modeli. Dla branż regulowanych — Bedrock w AWS, dane w Waszej VPC. Dla obronności i wrażliwego embedded — lokalne modele (Ollama, vLLM) na Waszych serwerach. Audit log każdej interakcji z AI. NDA podpisujemy przed pierwszą rozmową.' },
  { q: 'Co jeśli zespół nie kupi tej zmiany?', a: 'Najczęstszy opór to nie technologia, tylko obawa: „jak się zautomatyzuję, będę niepotrzebny”. Rozbrajamy ją na liczbach — programista prowadzący agenta dostarcza kilka razy więcej, więc jego wartość rośnie, nie maleje. Trening prowadzimy na ich kodzie, pierwsze dostawy w drugim tygodniu. A jeśli zespół się nie przekonuje — wstrzymujemy modernizację i wracamy do audytu. Bez wstydu, bez kar.' },
  { q: 'Jak zmierzymy efekt?', a: 'DORA metrics jako baseline w tygodniu 1: czas od ticketu do PR, czas merge, bug escape rate, pokrycie testami. Mierzymy ponownie w tygodniu 12. Raport ROI dla zarządu — dashboard z twardymi liczbami.' },
  { q: 'Rynek AI zmienia się co kwartał. Skąd pewność, że wybierzecie narzędzia, które się utrzymają?', a: 'Dobór technologii to nasz zawód od 25 lat — widzieliśmy, które wybory firmy spłacały latami. Koszt prób i błędów z agentami ponieśliśmy u siebie, nie u klientów. A program kończymy tak, żeby zespół sam umiał ocenić i przyjąć kolejne narzędzie — przewaga zostaje u Was, nie w naszym cenniku.' },
  { q: 'Ile to kosztuje?', a: 'Programy kwartalne nie są dla każdej firmy. Stała opłata kwartalna, zamknięty zakres, bez T&amp;M. Kwotę ustalamy po audycie i podajemy mailem w 48h.' },
  { q: 'Czy stara aplikacja będzie działać w trakcie pilota?', a: 'Tak. Pilot wchodzi obok: dwa systemy równolegle, moduł po module, testy regresyjne na danych z produkcji. Wasza baza danych zostaje bez zmian.' },
  { q: 'Czy to działa przy zespole 50+ osób?', a: 'Tak — falami. Nie szkolimy 50 osób naraz. Zaczynamy od jednego zespołu (5–10 osób) i pilota, wzorce zapisujemy w CLAUDE.md i standardach repo, a przeszkoleni programiści zostają championami kolejnych fal. Druga fala kosztuje mniej niż pierwsza, trzecia mniej niż druga.' },
  { q: 'Kto będzie pracował przy naszym projekcie?', a: 'Dwóch ludzi: Tomek Wojciechowski i Maciej Stopa. Te same dwie osoby od audytu do przekazania. Bez wymiany konsultantów, bez ekspertów-fantomów w ofercie, których potem nie widać. Tomek prowadzi AI workflow i strategię, Maciej — backend, mobile i frontend. Każdy poważny PR przechodzi przez dwie pary oczu.' },
];
---
<Base>
  <Nav />
<!-- ── HERO ─────────────────────────────────────────── -->
<section class="hero" aria-label="Wprowadzenie">
  <div class="container">
    <p class="eyebrow rv" data-scramble>Dla zarządów dużych firm</p>
    <h1 class="hero__title ws" style="margin-top: var(--space-lg)">Wasz zespół IT. 2–4&nbsp;razy szybszy. W&nbsp;dwa kwartały.</h1>
    <p class="hero__lead rv" style="--rv-d:.15s">Wdrażamy programowanie agentowe w zespołach IT dużych firm — szkolenie i wdrożenie na Waszym kodzie. Dowodem jest pilot: jeden moduł zmodernizowany do nowoczesnego stosu, z wynikiem zmierzonym na produkcji.</p>
    <div class="hero__cta rv" style="--rv-d:.25s">
      <BtnArrow href="#kontakt">Umów audyt 90 minut</BtnArrow>
      <a class="btn btn--ghost" href="#metoda">Zobacz, jak pracujemy</a>
    </div>
    <div class="hero__grid">
      <div class="hero__panel rv">
        <img src="/img/hero-panel.webp" alt="" loading="eager" fetchpriority="high" onload="this.parentElement.classList.add('has-img')" onerror="this.remove()">
        <p class="hero__panel-num" aria-hidden="true">2–4<em>×</em></p>
        <p class="hero__panel-cap">szybsze dostarczanie po dwóch kwartałach — ci sami ludzie, ten sam kod, nowy sposób pracy</p>
      </div>
      <div class="hero__aside rv" style="--rv-d:.1s">
        <p class="eyebrow">Pracujemy z firmami, których zespół IT liczy 30+ osób</p>
        <div class="hero__proof">
          <div><strong>40+ lat</strong> <span>łącznie (Tomek 25 · Maciej 18)</span></div>
          <div><strong>3 lata</strong> <span>z LLM-ami w produkcji, od premiery Claude Code</span></div>
          <div><strong>2 osoby</strong> <span>na każdym projekcie, bez wyjątku</span></div>
          <div><strong>2 kwartały</strong> <span>do zmierzonego wyniku na produkcji</span></div>
        </div>
      </div>
    </div>
  </div>
</section>

<div class="page-body">

  <!-- ── 01 PROBLEM ─────────────────────────────────── -->
  <section class="sect" id="problem" aria-labelledby="problem-title">
    <div class="container">
      <SectHead eyebrow="01 / Problem · Sytuacja zarządu" title="Wasz zespół zna biznes lepiej niż ktokolwiek na rynku. Tylko dostarcza wolniej, niż biznes potrzebuje." id="problem-title" small />
      <div class="problems">
        <div class="problem-row rv">
          <div>
            <p class="eyebrow">a</p>
            <h3>Konkurencja wypuszcza szybciej.</h3>
          </div>
          <p>Wasz zespół IT pracuje na pełnych obrotach, a aplikacje rozwijane od 20–30 lat kosztują w utrzymaniu coraz więcej. Każda zmiana idzie tygodniami.</p>
          <figure class="ph" style="--ph-ar: 4/3">
            <img src="/img/problem-a.webp" alt="Smugi świateł nocnej drogi mijające oszroniony serwer" loading="lazy" onerror="this.remove()">
          </figure>
        </div>
        <div class="problem-row rv">
          <div>
            <p class="eyebrow">b</p>
            <h3>Klasyczne odpowiedzi nie skalują się przy 30+ osobach.</h3>
          </div>
          <p>Rekrutacja trwa pół roku i podbija koszty. Outsourcing oddaje wiedzę o biznesie na zewnątrz. Rewrite całego systemu kończy się technologią, której zespół nie zna.</p>
          <figure class="ph" style="--ph-ar: 4/3">
            <img src="/img/problem-b.webp" alt="Ciemna hala identycznych szaf serwerowych znikających w mroku" loading="lazy" onerror="this.remove()">
          </figure>
        </div>
        <div class="problem-row rv">
          <div>
            <p class="eyebrow">c</p>
            <h3>AI obiecuje rozwiązanie.</h3>
          </div>
          <p>Ale pojedyncze licencje na copilota nie zmieniają tempa zespołu — zmienia je dopiero nowy sposób pracy.</p>
          <figure class="ph" style="--ph-ar: 4/3">
            <img src="/img/problem-c.webp" alt="Pomarańczowa iskra światła zamknięta w bryle lodu" loading="lazy" onerror="this.remove()">
          </figure>
        </div>
      </div>
      <div class="industries rv">
        <p class="eyebrow">Pracujemy w branżach</p>
        <div class="industries__grid">
          <article>
            <h3>Przemysł i energetyka</h3>
            <p>embedded/IoT, maszyny i CNC, automotive</p>
          </article>
          <article>
            <h3>Transport i płatności</h3>
            <p>systemy biletowe, POS</p>
          </article>
          <article>
            <h3>Sektor regulowany</h3>
            <p>obronność, fintech, medycyna</p>
          </article>
          <article>
            <h3>Software house, telco, R&amp;D</h3>
            <p>zespoły produktowe i usługowe</p>
          </article>
        </div>
      </div>
    </div>
  </section>

  <!-- ── 02 DLACZEGO TERAZ ──────────────────────────── -->
  <section class="sect" id="dlaczego-teraz" aria-labelledby="teraz-title" style="padding-top: 0">
    <div class="container">
      <SectHead eyebrow="02 / Dlaczego teraz · Okno przewagi" title="Rynek już to liczy. Pytanie, kto w Waszej branży policzy to pierwszy." id="teraz-title" />
      <div>
        <figure class="quote-card rv">
          <blockquote>„W produkcji oprogramowania rozwiązania agentowe przyspieszają pracę o 30 do 60 proc., a przy modernizacji systemów ERP pod kątem AI i chmury liczymy na kolejne 30–50 proc. wzrostu produktywności.”</blockquote>
          <figcaption><strong>Zbigniew Rymarczyk</strong> — wiceprezes Comarch, dyrektor sektora ERP · wypowiedź prasowa, czerwiec 2026</figcaption>
        </figure>
        <div class="now-stats">
          <article class="rv">
            <strong>20×&nbsp;szybciej</strong>
            <p>programowanie intencyjne wobec wspomaganego, na zadaniach mierzonych w naszych projektach</p>
          </article>
          <article class="rv" style="--rv-d:.1s">
            <strong>6–12&nbsp;miesięcy</strong>
            <p>zapowiadany horyzont w pełni autonomicznych agentów programistycznych</p>
          </article>
        </div>
        <p class="now-note rv">Większość rynku zatrzymała się na autouzupełnianiu i czacie z AI. My uczymy zespoły programowania intencyjnego: programista zleca agentowi zadanie — intencję, kontekst, kryteria odbioru — i ocenia wynik. Kwartał treningu teraz jest wart więcej niż rok doganiania później.</p>
        <div class="industries rv">
          <p class="eyebrow">Przewaga, która zostaje u Was</p>
          <div class="industries__grid">
            <article>
              <h3>Dobór technologii bez prób i błędów</h3>
              <p>Przeszliśmy kilka zmian platform — od Delphi, przez C++ i mobile, po agentów. Wiemy, które narzędzia przetrwają, a które są modą na kwartał. Wasza konkurencja będzie to sprawdzać na własnych budżetach.</p>
            </article>
            <article>
              <h3>Trzy lata z agentami w produkcji</h3>
              <p>Ślepe uliczki mamy za sobą — Wasz zespół startuje z workflow, do którego rynek dopiero będzie dochodził.</p>
            </article>
            <article>
              <h3>Narzędzia, których nie kupicie z półki</h3>
              <p>DEVLens do pomiaru zespołów, własne integracje agentów z bazami danych (m.in. open-source do IBM DB2), szablony konfiguracji sprawdzone we wdrożeniach. Zostają u Was po programie.</p>
            </article>
            <article>
              <h3>Wzorce z Waszej branży, nie z prezentacji</h3>
              <p>Legacy rozwijane 20–30 lat, embedded, płatności, energetyka — znamy je od środka. Zespół dostaje wzorce z realnych wdrożeń, nie ogólne szkolenie z AI.</p>
            </article>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── 03 METODA (ciemna) ─────────────────────────── -->
  <section class="sect sect--dark" id="metoda" aria-labelledby="metoda-title">
    <div class="container">
      <SectHead eyebrow="03 / Metoda · Jak to robimy" title="Trening AI, programowanie agentowe i pilot modernizacji. W dwa kwartały." id="metoda-title" small>
        <p class="sect-lead rv">Trzy ścieżki idą równolegle, nie po kolei — zespół uczy się AI na aplikacji, którą zna, więc pilot startuje bez rozgrzewki. Na końcu zostaje nowy sposób pracy, zmierzony wynik i wzorzec, którym zespół sam obejmuje resztę systemu.</p>
      </SectHead>
      <div class="paths">
        <article class="path rv">
          <figure class="ph ph--dark" style="--ph-ar: 16/9">
            <img src="/img/path-01.webp" alt="Stół warsztatowy z laptopami i odręcznymi diagramami w ciepłym świetle" loading="lazy" onerror="this.remove()">
          </figure>
          <p class="eyebrow">Ścieżka 01</p>
          <h3>Trening z AI</h3>
          <p>Zespół uczy się prowadzić agenta AI w codziennej pracy — na Waszym żywym kodzie, nie na slajdach. Po kilku spotkaniach każdy programista pracuje samodzielnie, a postęp widać w liczbach od pierwszego tygodnia (DEVLens).</p>
          <p class="path__lead">Prowadzi: Tomek Wojciechowski</p>
        </article>
        <article class="path rv" style="--rv-d:.1s">
          <figure class="ph ph--dark" style="--ph-ar: 16/9">
            <img src="/img/path-02.webp" alt="Pomarańczowe nici światła przeplatające się przez ciemną krystaliczną strukturę" loading="lazy" onerror="this.remove()">
          </figure>
          <p class="eyebrow">Ścieżka 02</p>
          <h3>Agentowe programowanie</h3>
          <p>Agenci wchodzą do pracy na Waszej obecnej aplikacji — bez przerwy w rozwoju produktu i bez zmiany technologii. Pierwsze realne dostawy w drugim tygodniu.</p>
          <p class="path__lead">Prowadzi: Tomek Wojciechowski</p>
        </article>
        <article class="path path--wide rv">
          <p class="eyebrow">Ścieżka 03</p>
          <h3>Pilot modernizacji</h3>
          <div class="path__cols">
            <p style="color: var(--color-text-inv-2)">Zespół przenosi jeden moduł na nowoczesny stos, w którym AI obniża koszt rozwoju nawet o 60% — razem z natywnymi aplikacjami iOS i Android w tym samym programie. Stara aplikacja działa przez cały czas, Wasza baza danych zostaje bez zmian. Pierwsze programy prowadzimy pod NDA — konkretne wyniki i nazwy klientów zaczniemy publikować w drugiej połowie 2026 roku.</p>
            <figure class="ph ph--dark" style="--ph-ar: 16/9">
              <img src="/img/path-03.webp" alt="Stara hala przemysłowa przechodząca w nowoczesną szklaną dobudowę o zmierzchu" loading="lazy" onerror="this.remove()">
            </figure>
          </div>
          <p class="path__lead">Prowadzi: Maciej Stopa (backend/mobile/frontend) + Tomek (architektura)</p>
        </article>
      </div>
      <div class="statement">
        <h3 class="ws">Zespół, który znacie. Tempo, którego nie znacie.</h3>
        <p class="rv">Bez wymiany ludzi. Bez utraty wiedzy o biznesie. W 3 miesiące, za stałą opłatę. <a href="/metoda">Pełna metoda →</a></p>
      </div>
    </div>
  </section>

  <!-- ── 04 KORZYŚCI ────────────────────────────────── -->
  <section class="sect" id="korzysci" aria-labelledby="korzysci-title">
    <div class="container">
      <SectHead eyebrow="04 / Korzyści" title="Co zyskujecie" id="korzysci-title" />
      <div class="benefits">
        <article class="benefit rv">
          <p class="eyebrow">01 / Tempo</p>
          <h3>To, co zajmowało 6 miesięcy — w 4 tygodnie.</h3>
          <p>Wcześniejszy przychód, szybsza reakcja na konkurencję. Mierzone DORA metrics od pierwszego tygodnia, nie deklaracjami.</p>
        </article>
        <article class="benefit rv" style="--rv-d:.1s">
          <p class="eyebrow">02 / Ludzie</p>
          <h3>Ci sami ludzie, nowe kompetencje.</h3>
          <p>Nie zatrudniacie nowych ludzi i nie tracicie wiedzy o biznesie. Programiści, którzy pracują z AI, rzadziej odchodzą — a Wasza firma staje się pracodawcą, do którego ludzie sami wysyłają CV.</p>
        </article>
        <article class="benefit rv" style="--rv-d:.2s">
          <p class="eyebrow">03 / Koszt</p>
          <h3>Niższy koszt rozwoju, z pilotem jako mnożnikiem.</h3>
          <p>W stosie z pilota koszt dalszego rozwoju spada nawet o 60% — a wzorzec skaluje się na kolejne moduły. W ramach stałego doradztwa idziemy dalej: eliminujemy opłaty licencyjne za zamknięte technologie. <a href="/doradztwo-technologiczne">Zobacz Doradztwo →</a></p>
        </article>
      </div>
    </div>
  </section>

  <!-- ── 05 CASE STUDY ──────────────────────────────── -->
  <section class="sect" id="case-study" aria-labelledby="case-title" style="padding-top: 0">
    <div class="container">
      <div class="case-card rv">
        <div>
          <p class="eyebrow" data-scramble>05 / Case study · RegioBus Systems</p>
          <h2 id="case-title">Sześć miesięcy planu. Cztery tygodnie do produktu.</h2>
          <figure>
            <blockquote>Zaplanowaliśmy 6 miesięcy na nowy system. Po czterech tygodniach mieliśmy działający produkt. Z czterech programistów zostawiliśmy jednego, z asystentem AI.</blockquote>
            <figcaption><strong>Marek Zawadzki</strong> — CTO, RegioBus Systems · LinkedIn i pełne dane referencyjne na życzenie po NDA</figcaption>
          </figure>
          <div class="case-card__meta">
            <p>Lead operacyjny: Maciej Stopa (backend + mobile NFC) · Tomek (AI workflow)</p>
            <p>Skala pilota: 4-osobowy zespół, jeden system. To samo robimy z jednym zespołem w Waszej organizacji — falami, zespół po zespole.</p>
          </div>
          <figure class="ph ph--dark" style="--ph-ar: 16/9">
            <img src="/img/case-regiobus.webp" alt="Miejski autobus nocą mijający oszkloną wiatę przystankową" loading="lazy" onerror="this.remove()">
          </figure>
        </div>
        <div class="case-card__stats">
          <div>
            <span>Czas</span>
            <strong>6 miesięcy <em>→ 4 tygodnie</em></strong>
          </div>
          <div>
            <span>Zespół</span>
            <strong>3 z 4 osób uwolnione</strong>
            <span style="margin-top: 4px">do nowych projektów · 0 odejść</span>
          </div>
          <div>
            <span>Roczne oszczędności</span>
            <strong>setki tysięcy złotych</strong>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── 06 WYNIKI ──────────────────────────────────── -->
  <section class="sect" id="wyniki" aria-labelledby="wyniki-title" style="padding-top: 0">
    <div class="container">
      <SectHead eyebrow="06 / Wyniki · Pozostałe projekty" title="Skrócenie czasu dostarczania w trzech różnych branżach." id="wyniki-title" small />
      <table class="results-table rv">
        <thead>
          <tr>
            <th scope="col">Projekt</th>
            <th scope="col">Dotychczas</th>
            <th scope="col">Po wdrożeniu</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>System biletowy</td>
            <td>6 miesięcy</td>
            <td><strong>4 tygodnie</strong></td>
          </tr>
          <tr>
            <td>Sterownik urządzenia przemysłowego</td>
            <td>2 miesiące</td>
            <td><strong>2 tygodnie</strong></td>
          </tr>
          <tr>
            <td>Panel sterowania (energetyka)</td>
            <td>nowy moduł</td>
            <td><strong>2 tygodnie</strong></td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- ── 07 PROCES ──────────────────────────────────── -->
  <section class="sect" id="proces" aria-labelledby="proces-title" style="padding-top: 0">
    <div class="container">
      <SectHead eyebrow="07 / Proces · Cztery kroki, dwa kwartały" title="Jak pracujemy. 3 miesiące. Stała opłata." id="proces-title" />
      <div class="steps">
        <article class="step rv">
          <p class="eyebrow">01 · Tydzień 1</p>
          <h3>Diagnoza</h3>
          <p>Analizujemy aplikację i zespół. Ustalamy zakres pilota i ścieżkę wdrożenia AI. Diagnozę prowadzi Tomek, w razie potrzeby dołącza Maciej.</p>
        </article>
        <article class="step rv" style="--rv-d:.08s">
          <p class="eyebrow">02 · Tydzień 2</p>
          <h3>Plan i wycena</h3>
          <p>Konkretny zakres, harmonogram, mierzalne wskaźniki. Wycenę zatwierdzamy obaj — bo to my będziemy projekt prowadzić.</p>
        </article>
        <article class="step rv" style="--rv-d:.16s">
          <p class="eyebrow">03 · Tygodnie 3–10</p>
          <h3>Trzy ścieżki na raz</h3>
          <p>Dwie ścieżki treningowe — AI i agentowe programowanie na obecnym kodzie — plus pilot modernizacji z natywnym mobile.</p>
        </article>
        <article class="step rv" style="--rv-d:.24s">
          <p class="eyebrow">04 · Tygodnie 11–12</p>
          <h3>Przekazanie</h3>
          <p>Dokumentacja, wskaźniki, samodzielny zespół zdolny do dalszego rozwoju aplikacji.</p>
        </article>
      </div>
      <div class="process-terms rv">
        <div><strong>3 miesiące</strong> <span>Razem</span></div>
        <div><strong>Stała opłata</strong> <span>Bez ukrytych kosztów</span></div>
        <div><strong>Bez przedłużania</strong> <span>Zamknięty zakres</span></div>
      </div>
      <div class="after-note rv">
        <div>
          <h3>A po dwóch kwartałach?</h3>
          <p>Firmom, które chcą utrzymać tempo, prowadzimy stałą współpracę: doradztwo technologiczne dla zarządu i zewnętrzny dział R&D.</p>
        </div>
        <BtnArrow class="btn btn--dark" href="/doradztwo-technologiczne">Zobacz Doradztwo</BtnArrow>
      </div>
      <div class="after-note rv">
        <div>
          <h3>Nie tylko IT — szkolimy też działy handlowe.</h3>
