---
import Interior from '../layouts/Interior.astro';
import SectHead from '../components/SectHead.astro';
import ProofStrip from '../components/ProofStrip.astro';
import CtaBand from '../components/CtaBand.astro';

// Narzędzia open source SZRON — treść wg starej strony (OpenSource.tsx)
const tools = [
  {
    name: 'frostie',
    badges: [{ label: 'Claude Code Plugin' }, { label: 'NEW', kind: 'new' }],
    desc: 'Assety do App Store i Google Play w jednym przebiegu. Plugin eksploruje appkę na symulatorze, nagrywa flow, renderuje oprawione screenshoty i wideo preview, a do tego warstwę Google Play: screenshoty 1080×1920 i obowiązkowy feature graphic 1024×500 — z jednego configu i jednego designu.',
    features: [
      'Studio live dla OBU sklepów naraz — zmiany renderują się w ~1 s',
      'Google Play: feature graphic, checklista reguł, eksport ZIP',
      'Kompatybilny z projektami goldie (config i design bez zmian)',
    ],
    install: '/plugin marketplace add clone147/frostie',
    github: 'https://github.com/clone147/frostie',
  },
  {
    name: 'szron-db2-mcp',
    badges: [{ label: 'MCP Server' }, { label: 'NEW', kind: 'new' }],
    desc: 'Serwer MCP, który podłącza agenta AI do bazy IBM DB2. Pytasz o dane zwykłym językiem — agent sam ułoży zapytanie, zaktualizuje rekord, w razie potrzeby stworzy tabelę. Bez otwierania konsoli DB2.',
    features: [
      'Pełen odczyt i zapis: SELECT, INSERT, UPDATE, DELETE',
      'Operacje DDL — CREATE, ALTER, DROP TABLE z constraintami',
      'Ochrona przed SQL injection — wymóg WHERE, walidacja zapytań',
    ],
    install: 'git clone https://github.com/clone147/szron-db2-mcp',
    github: 'https://github.com/clone147/szron-db2-mcp',
    related: { href: '/serwery-mcp', label: 'Serwery MCP w Akademii' },
  },
  {
    name: 'skill-imagegen',
    badges: [{ label: 'Claude Code Skill' }, { label: 'NEW', kind: 'new' }],
    desc: 'Generowanie obrazów AI z wbudowanym AI art directorem. Napisz prosty prompt — skill zamieni go w kinematograficzny opis i wygeneruje profesjonalny obraz. Wymienny model przez OpenRouter pod spodem.',
    features: [
      'Auto-enhancement: prosty prompt → profesjonalny opis',
      'Edycja z referencjami — do 14 obrazów wejściowych',
      'Rozdzielczości 1K / 2K / 4K, dowolne proporcje',
    ],
    install: 'claude install-skill https://github.com/clone147/skill-imagegen',
    github: 'https://github.com/clone147/skill-imagegen',
  },
  {
    name: 'humanizer-pl',
    badges: [{ label: 'Claude Code Skill' }],
    desc: 'Skill do Claude Code, który wykrywa i usuwa ślady AI z polskich tekstów. 37 wzorców specyficznych dla języka polskiego — imiesłowy, anglicyzmy, strona bierna, formułkowe zdania.',
    features: [
      '37 wzorców AI specyficznych dla polskiego',
      'Specyfika polskiego: imiesłowy, anglicyzmy, strona bierna',
      'Instalacja jedną linijką — gotowy do użycia w minutę',
    ],
    install: 'claude install-skill https://github.com/clone147/humanizer-pl',
    github: 'https://github.com/clone147/humanizer-pl',
  },
  {
    name: 'subtitle-downloader',
    badges: [{ label: 'Claude Code Skill' }, { label: 'NEW', kind: 'new' }],
    desc: 'Mówisz jaki film, jaki język — dostajesz napisy. Skill automatycznie wykrywa film z nazwy pliku i pobiera napisy z wielu źródeł.',
    features: [
      '3 źródła: subliminal, napiprojekt, OpenSubtitles',
      'Napiprojekt — najlepsza baza polskich napisów (hash MD5)',
      'Automatyczna detekcja filmu z nazwy pliku',
    ],
    install: 'claude install-skill https://github.com/clone147/subtitle-downloader',
    github: 'https://github.com/clone147/subtitle-downloader',
  },
  {
    name: 'stm32f429-disco-skill',
    badges: [{ label: 'Claude Code Skill' }, { label: 'NEW', kind: 'new' }],
    desc: 'Agent AI buduje, wgrywa i debuguje firmware STM32 z panelem LED 64×64 — i sam sprawdza efekt na fizycznym sprzęcie przez kamerę RTSP. Dwie platformy: Keil na Windows i w pełni open-source\'owy GCC na macOS.',
    features: [
      'Build + flash + debug SWO/GDB: Windows (Keil) i macOS (GCC, st-flash, OpenOCD)',
      'Weryfikacja na sprzęcie — kamera RTSP mierzy, czy panel naprawdę świeci',
      'HTTPS na mikrokontrolerze: mbedTLS + CycloneTCP, handshake w 1,7 s na 168 MHz',
    ],
    install: 'claude install-skill https://github.com/clone147/stm32f429-disco-skill',
    github: 'https://github.com/clone147/stm32f429-disco-skill',
    related: { href: '/stm32-skill', label: 'Konfigurator skilla STM32' },
  },
  {
    name: 'chrome-tab-ungrouper',
    category: 'Wtyczki do przeglądarki',
    badges: [{ label: 'Wtyczka Chrome' }, { label: 'NEW', kind: 'new' }],
    desc: 'Chrome grupuje karty i nie da się tego wyłączyć w ustawieniach. Ta wtyczka rozgrupowuje każdą grupę w momencie jej powstania — także te tworzone przez Claude Code / Claude in Chrome.',
    features: [
      'Manifest V3, service worker — bez UI, bez opcji, ~30 linii kodu',
      'Reaguje na nową grupę, zmianę grupy i kartę dołożoną do grupy',
      'Zero dostępu do treści stron i zero ruchu sieciowego',
    ],
    install: 'git clone https://github.com/clone147/chrome-tab-ungrouper',
    github: 'https://github.com/clone147/chrome-tab-ungrouper',
  },
];

// Kolejność sekcji na stronie; narzędzia bez `category` lądują w domyślnej grupie.
const categories = ['Serwery MCP', 'Skille do Claude Code', 'Wtyczki do przeglądarki'];
const catOf = (t) => t.category ?? (t.name === 'szron-db2-mcp' ? 'Serwery MCP' : 'Skille do Claude Code');
const grouped = categories
  .map((c) => ({ name: c, items: tools.filter((t) => catOf(t) === c) }))
  .filter((g) => g.items.length);
---
<Interior
  title="Open source — narzędzia AI od SZRON"
  description="Narzędzia open source, które tworzymy przy wdrożeniach AI — serwer MCP dla IBM DB2, skille do Claude Code i wtyczki do przeglądarki. Udostępniamy za darmo na licencji MIT."
  eyebrow="Open source"
  heading="Budujemy na otwarto."
  lead="Narzędzia, które tworzymy przy wdrożeniach AI — udostępniamy za darmo. Używaj, kontrybuuj, rozwijaj."
  heroImage="/img/sub/open-source.webp"
  heroAlt="Kryształy szronu splecione w otwartą kratę z pomarańczowymi spoinami"
>
  <!-- proof -->
  <ProofStrip items={[
    ['6 narzędzi', 'serwer MCP, skille Claude Code, wtyczka Chrome'],
    ['37 wzorców', 'w humanizerze polskiego tekstu'],
    ['MIT License', 'za darmo, bez haczyków'],
  ]} />

  <!-- narzędzia -->
  <section class="sect" aria-labelledby="narzedzia">
    <div class="container">
      <SectHead eyebrow="01 / Narzędzia · Sprawdzone w boju" title="Każde powstało przy realnym projekcie wdrożeniowym." id="narzedzia" small />
      <img class="hero-img rv" src="/img/sub/open-source-biurko.webp" alt="Laptop z naklejkami projektów open source i otwartym repozytorium kodu" width="1380" height="768" loading="lazy" />
      {grouped.map((g) => (
        <div class="tools-cat">
          <p class="eyebrow tools-cat__head rv" data-scramble>{g.name}</p>
          <div class="tools-grid">
            {g.items.map((t, i) => (
              <article class="card-tile tool-card rv" style={`--rv-d:${(i * 0.08).toFixed(2)}s`}>
                <div class="badges">
                  {t.badges.map((b) => <span class={`badge${b.kind === 'new' ? ' badge--new' : ''}`}>{b.label}</span>)}
                </div>
                <h3>{t.name}</h3>
                <p>{t.desc}</p>
                <ul class="features">
                  {t.features.map((f) => <li>{f}</li>)}
                </ul>
                <div class="install">
                  <code>{t.install}</code>
                  <button type="button" class="install__btn" data-copy={t.install} aria-label={`Kopiuj komendę instalacji ${t.name}`}>Kopiuj</button>
                </div>
                <p class="tool-foot"><a href={t.github} target="_blank" rel="noopener noreferrer">Zobacz na GitHub →</a>{t.related && <> · <a href={t.related.href}>{t.related.label} →</a></>}</p>
              </article>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- dlaczego open source -->
  <section class="sect sect--dark" aria-labelledby="dlaczego">
    <div class="container">
      <SectHead eyebrow="02 / Dlaczego · Po co to robimy" title="Dlaczego open source?" id="dlaczego" />
      <p class="sect-lead rv">Te narzędzia to produkt uboczny naszych wdrożeń — za każdym stoi problem, na który sami trafiliśmy u klienta. Publikujemy je na MIT, bo feedback developerów, którzy używają ich na co dzień, ulepsza je szybciej niż jakakolwiek kampania. A jeśli chcesz zobaczyć, jak pracujemy z AI na Waszym kodzie — zacznij od <a href="/coaching-sprint">coaching sprintu</a>.</p>
    </div>
  </section>

  <!-- CTA -->
  <CtaBand
    eyebrow="Open source"
    heading="Masz pomysł na narzędzie?"
    text="Budujemy narzędzia, które pomagają polskim zespołom pracować z AI. Jeśli masz pomysł albo chcesz kontrybuować — napisz."
    btnLabel="Napisz do nas"
    btnHref="/kontakt"
    ghostLabel="Zobacz GitHub"
    ghostHref="https://github.com/clone147"
    ghostExternal={true}
    padTop={false}
  />

  <script is:inline>
    document.querySelectorAll('.install__btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(btn.getAttribute('data-copy'));
          const old = btn.textContent;
          btn.textContent = 'Skopiowano';
          btn.classList.add('is-done');
          setTimeout(() => { btn.textContent = old; btn.classList.remove('is-done'); }, 2000);
        } catch (e) {}
      });
    });
  </script>
</Interior>
