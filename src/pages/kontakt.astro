---
import Interior from '../layouts/Interior.astro';
import SectHead from '../components/SectHead.astro';
import BtnArrow from '../components/BtnArrow.astro';
---
<Interior
  title="Kontakt — mail, telefon, adres | SZRON"
  description="Kontakt z SZRON: mail tw@szron.tech, telefon +48 505 091 200, Rzeszów — pracujemy z firmami z całej Polski. Rozmowę diagnostyczną umówisz na osobnej stronie."
  eyebrow="Kontakt"
  heading="Najprościej: napiszcie albo zadzwońcie."
  lead="Mail albo telefon — odpowiadamy w 24h w dni robocze. A jeśli chcecie od razu zaplanować 30-minutową diagnozę z formularzem i kalendarzem, przejdźcie do „Umów rozmowę”."
  heroImage="/img/sub/kontakt.webp"
  heroAlt="Tomek i Maciej przy stole w jasnym biurze, z laptopami i kawą — gotowi do rozmowy"
>
  <!-- 01 dane kontaktowe -->
  <section class="sect" aria-labelledby="napisac">
    <div class="container">
      <SectHead eyebrow="01 / Dane · Mail, telefon, adres" title="Wybierzcie, co wygodniejsze." id="napisac" small />
      <dl class="def-rows rv">
        <div><dt>Email<small>tw@szron.tech</small></dt><dd>Odpowiadamy w 24h w dni robocze. Załączcie krótki opis aplikacji — odpowiemy już z pierwszymi pytaniami.</dd></div>
        <div><dt>Telefon<small>+48 505 091 200</small></dt><dd>Wolimy zaplanowaną rozmowę — wtedy jesteśmy przygotowani. Awaryjnie dzwońcie pn–pt 9–17.</dd></div>
        <div><dt>Adres<small>Rzeszów · Polska</small></dt><dd>SZRON Tomek Wojciechowski, ul. Legionistów 12/1/B, 35-317 Rzeszów. Pracujemy z firmami z całej Polski — spotkania na Teams.</dd></div>
      </dl>
      <div class="contact__cta rv" style="margin-top:var(--space-2xl)">
        <BtnArrow href="/umow-rozmowe">Umów 30-minutową rozmowę</BtnArrow>
      </div>
    </div>
  </section>
</Interior>
