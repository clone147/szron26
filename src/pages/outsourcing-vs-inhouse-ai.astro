---
import Interior from '../layouts/Interior.astro';
import SectHead from '../components/SectHead.astro';
import ProofStrip from '../components/ProofStrip.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';

// FAQ — numeracja 01…NN generowana w <Faq />
const faq = [
  { q: 'Czy mogę połączyć oba podejścia?', a: 'Tak — i często to najlepszy układ. Można zacząć od programu kwartalnego ze SZRON, a potem wyznaczyć lub zatrudnić własnego championa AI, którego przeszkolimy. Zmniejsza to ryzyko złej rekrutacji.' },
  { q: 'Co jeśli osoba prowadząca temat AI odejdzie?', a: 'To główne ryzyko modelu in-house — wiedza wychodzi z firmy razem z człowiekiem. U nas program prowadzi dwóch seniorów, a wszystko, co wypracujemy — standardy, konfiguracje, dokumentacja, przeszkolony zespół — zostaje w Waszej organizacji, nie w jednej głowie.' },
];
---
<Interior
  title="Outsourcing AI vs in-house — koszty | SZRON"
  description="Porównaj koszty współpracy z SZRON i zatrudnienia eksperta AI in-house: całkowity koszt, czas do produktywności, ryzyko odejścia i transfer wiedzy."
  eyebrow="Porównanie · outsourcing vs in-house"
  heading="SZRON vs ekspert AI in-house."
  lead="Który model jest lepszy dla Waszej firmy? Zestawiamy oba podejścia obiektywnie: całkowity koszt posiadania, czas do produktywności, ryzyko i transfer wiedzy — żebyście mogli wybrać świadomie."
  heroImage="/img/sub/outsourcing-vs-inhouse-ai.webp"
  heroTone="ice"
  heroAlt="Dwa bloki lodu na zamrożonej wadze, jeden świeci pomarańczowo"
>
  <!-- proof -->
  <ProofStrip items={[
    ['Stała opłata za kwartał', 'zamknięty zakres, kwota po audycie — etat to 25–40 tys. PLN/mies.'],
    ['Czas do startu', '1–2 tygodnie vs 3–6 miesięcy rekrutacji i onboardingu'],
    ['Bez ryzyka odejścia', 'wiedza w organizacji, nie w jednej osobie'],
  ]} />

  <!-- 01 TCO -->
  <section class="sect" aria-labelledby="tco">
    <div class="container">
      <SectHead eyebrow="01 / Koszty · Całkowity koszt posiadania" title="Co realnie kosztuje ekspert in-house, a co program kwartalny." id="tco" />
      <table class="results-table rv">
        <thead><tr><th scope="col">Składnik</th><th scope="col">Ekspert in-house (miesięcznie)</th><th scope="col">SZRON — program kwartalny</th></tr></thead>
        <tbody>
          <tr><td>Wynagrodzenie / opłata</td><td>25 000 PLN</td><td><strong>stała opłata za kwartał</strong></td></tr>
          <tr><td>Koszty pracodawcy (ZUS, PPK, ubezpieczenia)</td><td>7 500 PLN</td><td><strong>w cenie</strong></td></tr>
          <tr><td>Narzędzia i licencje</td><td>2 000 PLN</td><td><strong>w cenie</strong></td></tr>
          <tr><td>Szkolenia</td><td>2 500 PLN</td><td><strong>w cenie</strong></td></tr>
          <tr><td>Rekrutacja (amortyzacja)</td><td>3 333 PLN</td><td><strong>brak</strong></td></tr>
          <tr><td>Razem</td><td>40 333 PLN / mies.</td><td><strong>jedna kwota, znana przed startem</strong></td></tr>
        </tbody>
      </table>
      <p class="rv" style="margin-top:var(--space-md);color:var(--color-muted)">Kwota in-house to pełny koszt etatu, nie sama pensja — koszty pracodawcy obejmują ZUS, PPK i ubezpieczenia, a rekrutacja to 40 tys. PLN rozłożone na rok. Program kwartalny ma zamknięty zakres i jedną, znaną z góry kwotę — dostaniecie ją mailem w 48 godzin po audycie.</p>
    </div>
  </section>

  <!-- 02 pełne porównanie (ciemna) -->
  <section class="sect sect--dark" aria-labelledby="porownanie">
    <div class="container">
      <SectHead eyebrow="02 / Porównanie · Pełne zestawienie" title="Osiem kryteriów. Gdzie wygrywa który model." id="porownanie" />
      <table class="results-table rv">
        <thead><tr><th scope="col">Kryterium</th><th scope="col">SZRON</th><th scope="col">Champion + SZRON</th><th scope="col">In-house</th></tr></thead>
        <tbody>
          <tr><td>Koszty<br><small>in-house: brutto z kosztami pracodawcy plus narzędzia</small></td><td>jedna kwota za kwartał</td><td>opłata + czas championa</td><td><strong>25–40 tys. PLN / mies.</strong></td></tr>
          <tr><td>Czas do produktywności<br><small>rekrutacja plus onboarding plus nauka stacku</small></td><td>1–2 tygodnie</td><td>1–2 tygodnie</td><td><strong>3–6 miesięcy</strong></td></tr>
          <tr><td>Ryzyko odejścia<br><small>jeden ekspert to pojedynczy punkt awarii</small></td><td>żadne</td><td>niskie — wiedza w zespole</td><td><strong>wysokie</strong></td></tr>
          <tr><td>Dostęp do wiedzy<br><small>doświadczenie z wielu wdrożeń vs jedna firma</small></td><td>wielobranżowy</td><td>wielobranżowy + kontekst firmy</td><td><strong>ograniczony</strong></td></tr>
          <tr><td>Elastyczność<br><small>skalowanie w górę i w dół bez problemu</small></td><td>kolejny kwartał to decyzja, nie zobowiązanie</td><td>champion zostaje po programie</td><td><strong>umowa o pracę</strong></td></tr>
          <tr><td>Transfer wiedzy<br><small>dokumentacja i szkolenia w standardzie</small></td><td>w pakiecie</td><td>wbudowany w program</td><td><strong>tylko jeśli zostanie</strong></td></tr>
          <tr><td>Dedykacja<br><small>kto pilnuje tematu na co dzień</small></td><td>my, w ramach programu</td><td>champion na miejscu</td><td><strong>pełny etat</strong></td></tr>
          <tr><td>Znajomość firmy<br><small>kontekst biznesowy vs ekspertyza AI</small></td><td>wymaga onboardingu</td><td>pełna</td><td><strong>pełna</strong></td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- 03 podsumowanie -->
  <section class="sect" aria-labelledby="podsumowanie">
    <div class="container">
      <SectHead eyebrow="03 / Podsumowanie · Kiedy co wybrać" title="Nie ma jednej odpowiedzi — jest dopasowanie do sytuacji." id="podsumowanie" small />
      <div class="grid-cards">
        <article class="card-tile rv">
          <p class="eyebrow">SZRON</p>
          <h3>Wybierzcie SZRON, gdy:</h3>
          <p>Zaczynacie transformację AI. Chcecie szybkiego startu (tygodnie, nie miesiące). Potrzebujecie elastyczności. Nie chcecie ryzyka rekrutacji.</p>
        </article>
        <article class="card-tile rv" style="--rv-d:.1s">
          <p class="eyebrow">Champion + SZRON</p>
          <h3>Wybierzcie model łączony, gdy:</h3>
          <p>Macie w zespole seniora, który już ciągnie temat AI. My wnosimy metodę i pomiar, champion utrzymuje tempo po programie.</p>
        </article>
        <article class="card-tile rv" style="--rv-d:.2s">
          <p class="eyebrow">In-house</p>
          <h3>Wybierzcie in-house, gdy:</h3>
          <p>Macie 100+ pracowników. Potrzebujecie dedykacji na pełny etat. Macie unikalne, wewnętrzne systemy. Budujecie własny dział AI.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- 04 FAQ -->
  <section class="sect" aria-labelledby="faq-title" style="padding-top:0">
    <div class="container">
      <SectHead eyebrow="04 / FAQ · Najczęstsze pytania" title="Pytania o wybór modelu." id="faq-title" small />
      <Faq items={faq} />
    </div>
  </section>

  <!-- kontakt CTA -->
  <CtaBand
    eyebrow="Kontakt"
    heading="Chcecie porozmawiać o opcjach?"
    text="Pomożemy wybrać model najlepszy dla Waszej sytuacji — a jeśli to program kwartalny, kwotę poznacie w 48 godzin po audycie. Bez presji: pierwsza rozmowa to konkretne pytania, nie sprzedaż."
    btnLabel="Zarezerwuj termin"
  />
</Interior>
