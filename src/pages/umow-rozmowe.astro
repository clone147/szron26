---
import Interior from '../layouts/Interior.astro';
import SectHead from '../components/SectHead.astro';
import ProofStrip from '../components/ProofStrip.astro';
import Faq from '../components/Faq.astro';
import LeadForm from '../components/LeadForm.astro';
import CallPrep from '../components/CallPrep.astro';
import { faqRozmowa } from '../data/faq-rozmowa.mjs';
---
<Interior
  title="Umów rozmowę — audyt 90 minut | SZRON"
  description="Krótki formularz, wracamy w 24h. Audyt 90 minut: pytania o stos i zespół, bez sprzedaży, pisemny raport. Stała wycena kwartału w 48h, jeśli widzimy sens współpracy."
  eyebrow="Audyt · 90 minut"
  heading="90 minut. Pokażemy, gdzie tracicie tempo."
  lead="Bez sprzedaży. Konkretne pytania o stos technologiczny i zespół, po rozmowie pisemny raport: gdzie AI da u Was największy efekt i co stoi na przeszkodzie. Jeśli jest sens współpracy — dostaniecie stałą wycenę kwartału w ciągu 48h, zatwierdzoną przez nas obu."
  heroImage="/img/sub/umow-rozmowe.webp?v=2"
  heroAlt="Wideorozmowa na laptopie — na ekranie Tomek uśmiecha się do kamery; obok kubek kawy w ciepłym popołudniowym świetle"
>
  <!-- proof -->
  <ProofStrip items={[
    ['90 minut', 'wideo lub telefon — wybieracie format'],
    ['Pisemny raport', 'na jednej stronie, mailem w 24h'],
    ['Po stronie SZRON', 'Tomek Wojciechowski, w razie potrzeby Maciej'],
  ]} />

  <!-- formularz (ciemna) -->
  <LeadForm name="umow-rozmowe" />

  <CallPrep />

  <!-- 04 alternatywy + FAQ -->
  <section class="sect" aria-labelledby="napisac">
    <div class="container">
      <SectHead eyebrow="04 / Alternatywa · Mail albo telefon" title="Wolicie napisać albo zadzwonić?" id="napisac" small />
      <dl class="def-rows rv">
        <div><dt>Email<small>tw@szron.tech</small></dt><dd>Odpowiadamy w dni robocze. Załączcie krótki opis aplikacji — odpowiemy już z pierwszymi pytaniami.</dd></div>
        <div><dt>Telefon<small>+48 505 091 200</small></dt><dd>Wolimy zaplanowaną rozmowę przez formularz — wtedy jesteśmy przygotowani. Awaryjnie dzwońcie pn–pt 9–17.</dd></div>
      </dl>
    </div>
  </section>

  <!-- 05 FAQ -->
  <section class="sect" aria-labelledby="faq-title" style="padding-top:0">
    <div class="container">
      <SectHead eyebrow="05 / FAQ · Przed pierwszą rozmową" title="Pytania, które padają przed pierwszą rozmową." id="faq-title" small />
      <Faq items={faqRozmowa} />
    </div>
  </section>
</Interior>
