---
import Interior from '../layouts/Interior.astro';
import SectHead from '../components/SectHead.astro';
import ProofStrip from '../components/ProofStrip.astro';
import CtaBand from '../components/CtaBand.astro';
---
<Interior
  updated="2026-07-16"
  title="GCC kontra Keil — benchmark STM32 na sprzęcie | SZRON"
  description="Ten sam firmware (panel LED 64×64, FreeRTOS + CycloneTCP) zbudowany 5 wariantami toolchaina i zmierzony na płytce STM32F429. GCC po tuningu: 3,75× szybszy i 2,4× mniejszy od Keila. Cały eksperyment wykonał agent AI."
  ogDescription="Benchmark na prawdziwym STM32F429: open-source GCC bije komercyjny Keil 3,75× na szybkości i 2,4× na rozmiarze. Eksperyment od kodu po pomiar wykonał agent AI."
  ogImage="/img/sub/keil-vs-gcc.webp"
  eyebrow="Embedded · Benchmark na sprzęcie"
  heading="GCC kontra Keil: open-source wygrywa na rozmiarze i szybkości."
  headingSmall
  lead="Ten sam kod źródłowy — panel LED 64×64, FreeRTOS + CycloneTCP — zbudowany pięcioma wariantami toolchaina i zmierzony licznikiem cykli DWT bezpośrednio na STM32F429. Po tuningu bibliotek GCC 14.2 bije komercyjny Keil ARMCC w każdym teście. A cały eksperyment, od kodu po pomiar, wykonał agent AI."
  heroImage="/img/sub/keil-vs-gcc.webp"
  heroAlt="Płytka STM32 połączona z matrycą LED 64×64 wyświetlającą wykres słupkowy porównania wydajności"
>
  <ProofStrip items={[
    ['3,75× szybciej', 'GCC tuned: 51 ms vs 194 ms Keila (cały benchmark)'],
    ['2,4× mniejszy firmware', '220 kB vs 537 kB ROM — ta sama funkcjonalność'],
    ['0 zł licencji', 'GCC + newlib są w pełni open-source'],
  ]} />

  <!-- 01 mapa efektywności -->
  <section class="sect" aria-labelledby="mapa">
    <div class="container">
      <SectHead eyebrow="01 / Wynik · Jeden wykres" title="Mapa efektywności: rozmiar × szybkość." id="mapa" small />
      <div class="prose rv"><p>Każdy punkt to jeden kompletny firmware wgrany i zmierzony na płytce. Ideał — mały i szybki — leży w lewym dolnym rogu. Warianty Keila siedzą w prawej, „ciężkiej" części wykresu i nie schodzą poniżej 194&nbsp;ms. <strong>GCC −O2 tuned łączy mały rozmiar z czasem niedostępnym dla Keila — dominuje wykres w sensie Pareto.</strong></p></div>
      <figure class="bm-card bm-scroll rv" aria-label="Wykres punktowy: rozmiar ROM na osi X, czas benchmarku na osi Y">
        <svg viewBox="0 0 720 400" width="100%" role="img" style="min-width:620px">
          <line class="bm-grid" x1="70" y1="269" x2="690" y2="269"/><line class="bm-grid" x1="70" y1="198" x2="690" y2="198"/>
          <line class="bm-grid" x1="70" y1="127" x2="690" y2="127"/><line class="bm-grid" x1="70" y1="56" x2="690" y2="56"/>
          <line class="bm-grid" x1="165" y1="20" x2="165" y2="340"/><line class="bm-grid" x1="261" y1="20" x2="261" y2="340"/>
          <line class="bm-grid" x1="356" y1="20" x2="356" y2="340"/><line class="bm-grid" x1="452" y1="20" x2="452" y2="340"/>
          <line class="bm-grid" x1="547" y1="20" x2="547" y2="340"/><line class="bm-grid" x1="643" y1="20" x2="643" y2="340"/>
          <line class="bm-axis" x1="70" y1="340" x2="690" y2="340"/><line class="bm-axis" x1="70" y1="20" x2="70" y2="340"/>
          <text class="bm-tick" x="62" y="344" text-anchor="end">0</text><text class="bm-tick" x="62" y="273" text-anchor="end">100</text>
          <text class="bm-tick" x="62" y="202" text-anchor="end">200</text><text class="bm-tick" x="62" y="131" text-anchor="end">300</text>
          <text class="bm-tick" x="62" y="60" text-anchor="end">400</text>
          <text class="bm-tick" x="26" y="180" transform="rotate(-90 26 180)" text-anchor="middle">czas [ms]</text>
          <text class="bm-tick" x="70" y="358" text-anchor="middle">0</text><text class="bm-tick" x="165" y="358" text-anchor="middle">100</text>
          <text class="bm-tick" x="261" y="358" text-anchor="middle">200</text><text class="bm-tick" x="356" y="358" text-anchor="middle">300</text>
          <text class="bm-tick" x="452" y="358" text-anchor="middle">400</text><text class="bm-tick" x="547" y="358" text-anchor="middle">500</text>
          <text class="bm-tick" x="643" y="358" text-anchor="middle">600</text>
          <text class="bm-tick" x="380" y="384" text-anchor="middle">rozmiar ROM [kB]</text>
          <text class="bm-ideal" x="82" y="330">◤ cel: mały i szybki</text>
          <circle class="bm-pt" cx="627" cy="51" r="7" fill="var(--bm-gcc0)"/>
          <text class="bm-lbl" x="616" y="43" text-anchor="end">GCC −O0 · 584 kB · 406 ms</text>
          <circle class="bm-pt" cx="270" cy="107" r="7" fill="var(--bm-gcc2)"/>
          <text class="bm-lbl" x="284" y="103">GCC −O2 · 210 kB · 327 ms</text>
          <circle class="bm-pt" cx="582" cy="202" r="7" fill="var(--bm-keil)"/>
          <text class="bm-lbl" x="571" y="194" text-anchor="end">Keil default · 537 kB · 194 ms</text>
          <circle class="bm-pt" cx="556" cy="202" r="7" fill="var(--bm-keil2)"/>
          <text class="bm-lbl" x="545" y="222" text-anchor="end">Keil −O2+split · 510 kB · 194 ms</text>
          <circle class="bm-pt bm-pt--win" cx="280" cy="304" r="9" fill="var(--bm-tuned)"/>
          <circle class="bm-halo" cx="280" cy="304" r="13" fill="none" stroke="var(--bm-tuned)" stroke-width="1.5"/>
          <text class="bm-lbl bm-lbl--win" x="298" y="300">GCC −O2 tuned · 220 kB · 51 ms</text>
        </svg>
      </figure>
    </div>
  </section>

  <!-- 02 anatomia czasu -->
  <section class="sect sect--dark" aria-labelledby="anatomia">
    <div class="container">
      <SectHead eyebrow="02 / Anatomia · Skąd ten czas" title="Z czego składa się każdy pasek." id="anatomia" small />
      <div class="prose prose--inv rv"><p>Cykle CPU w podziale na trzy testy (wspólna skala, 100% = GCC −O0). W obu „fabrycznych" buildach GCC czas pożera segment MEM — bajtowe <code>memcpy</code>/<code>memset</code> z newlib-nano. Podmiana tych trzech funkcji (<code>fast_libc.c</code>) skraca pasek o ~40&nbsp;mln cykli; u Keila analogiczny segment to wciąż 25&nbsp;mln.</p></div>
      <div class="bm-bars rv" id="bm-bars">
        <div class="bm-row"><span class="bm-row__lbl"><i class="bm-dot" style="background:var(--bm-gcc0)"></i>GCC −O0</span>
          <span class="bm-track">
            <span class="bm-seg" data-w="20.6" style="background:var(--bm-gcc0)"></span>
            <span class="bm-seg" data-w="12.1" style="background:var(--bm-gcc0);opacity:.72"></span>
            <span class="bm-seg" data-w="67.2" style="background:var(--bm-gcc0);opacity:.45"></span>
          </span><span class="bm-val" data-count="406">0 ms</span></div>
        <div class="bm-row"><span class="bm-row__lbl"><i class="bm-dot" style="background:var(--bm-gcc2)"></i>GCC −O2</span>
          <span class="bm-track">
            <span class="bm-seg" data-w="3.5" style="background:var(--bm-gcc2)"></span>
            <span class="bm-seg" data-w="10.0" style="background:var(--bm-gcc2);opacity:.72"></span>
            <span class="bm-seg" data-w="67.2" style="background:var(--bm-gcc2);opacity:.45"></span>
          </span><span class="bm-val" data-count="327">0 ms</span></div>
        <div class="bm-row"><span class="bm-row__lbl"><i class="bm-dot" style="background:var(--bm-keil)"></i>Keil default</span>
          <span class="bm-track">
            <span class="bm-seg" data-w="4.8" style="background:var(--bm-keil)"></span>
            <span class="bm-seg" data-w="6.1" style="background:var(--bm-keil);opacity:.72"></span>
            <span class="bm-seg" data-w="36.9" style="background:var(--bm-keil);opacity:.45"></span>
          </span><span class="bm-val" data-count="194">0 ms</span></div>
        <div class="bm-row bm-row--win"><span class="bm-row__lbl"><i class="bm-dot" style="background:var(--bm-tuned)"></i><strong>GCC −O2 tuned</strong></span>
          <span class="bm-track">
            <span class="bm-seg" data-w="1.4" style="background:var(--bm-tuned)"></span>
            <span class="bm-seg" data-w="3.5" style="background:var(--bm-tuned);opacity:.72"></span>
            <span class="bm-seg" data-w="7.8" style="background:var(--bm-tuned);opacity:.45"></span>
          </span><span class="bm-val" data-count="51"><strong>0 ms</strong></span></div>
        <p class="bm-sublegend">segmenty od lewej: <span>INT (pełny kolor)</span> · <span>FLOAT (72%)</span> · <span>MEM (najjaśniejszy)</span></p>
      </div>
    </div>
  </section>

  <!-- 03 mapa flash LED -->
  <section class="sect" aria-labelledby="flash">
    <div class="container">
      <SectHead eyebrow="03 / Pamięć · Ile zostaje na rozwój" title="Zajętość pamięci flash." id="flash" small />
      <div class="prose rv"><p>Każdy punkt to 16&nbsp;kB z 2&nbsp;MB flasha STM32F429. Firmware z GCC −O2 zajmuje 13 ze 128 bloków; Keil potrzebuje ich prawie trzykrotnie więcej. Wolna przestrzeń to realny zapas na rozwój produktu — kolejne funkcje, fonty, bufory.</p></div>
      <div class="bm-card rv"><div class="bm-flash" id="bm-flash"></div></div>
    </div>
  </section>

  <!-- 04 pełne dane -->
  <section class="sect" aria-labelledby="dane">
    <div class="container">
      <SectHead eyebrow="04 / Dane · Bez skrótów" title="Pełne wyniki pomiarowe." id="dane" small />
      <div class="bm-card bm-scroll rv">
        <table class="bm-table">
          <thead><tr>
            <th>Test</th>
            <th><i class="bm-dot" style="background:var(--bm-keil)"></i>Keil default</th>
            <th><i class="bm-dot" style="background:var(--bm-keil2)"></i>Keil −O2+split</th>
            <th><i class="bm-dot" style="background:var(--bm-gcc0)"></i>GCC −O0</th>
            <th><i class="bm-dot" style="background:var(--bm-gcc2)"></i>GCC −O2</th>
            <th><i class="bm-dot" style="background:var(--bm-tuned)"></i>GCC −O2 tuned</th>
            <th>Najlepszy</th>
          </tr></thead>
          <tbody>
            <tr><td>ROM (kod + dane)</td><td>536,7 kB</td><td>509,7 kB</td><td>584,2 kB</td><td>210,2 kB</td><td>219,7 kB</td><td class="bm-win">GCC · 2,4×</td></tr>
            <tr><td>INT — pętla LCG, 200 tys. iteracji</td><td>19 ms</td><td>19 ms</td><td>83 ms</td><td>14 ms</td><td>5 ms</td><td class="bm-win">tuned · 3,35×</td></tr>
            <tr><td>FLOAT — sinf() na FPU, 20 tys. iteracji</td><td>24 ms</td><td>26 ms</td><td>49 ms</td><td>40 ms</td><td>14 ms</td><td class="bm-win">tuned · 1,73×</td></tr>
            <tr><td>MEM — memset+memcpy, 500 × 4 kB</td><td>149 ms</td><td>148 ms</td><td>273 ms</td><td>273 ms</td><td>31 ms</td><td class="bm-win">tuned · 4,70×</td></tr>
            <tr class="bm-total"><td>RAZEM</td><td>194 ms</td><td>194 ms</td><td>406 ms</td><td>327 ms</td><td><strong>51 ms</strong></td><td class="bm-win">tuned · 3,75×</td></tr>
          </tbody>
        </table>
      </div>
      <div class="prose rv" style="margin-top:var(--space-lg)">
        <details class="bm-details"><summary>Metodologia i uczciwość porównania (rozwiń)</summary>
          <p><strong>Warianty.</strong> Keil MDK 5.37 (ARMCC 5.06u7): „default" to domyślna optymalizacja armcc (≈−O2 — jawne ustawienie −O2 nie zmieniło czasów, zmniejszyło tylko ROM przez split sections). GCC: Arm GNU Toolchain 14.2.Rel1, newlib-nano, linker script z SW4STM32.</p>
          <p><strong>Wariant „tuned"</strong> = GCC −O2 + trzy zmiany: <strong>(a)</strong> własne słowo-po-słowie <code>memcpy</code>/<code>memset</code> i wielomianowy <code>sinf</code> (<code>fast_libc.c</code> — nadpisują bajtowe wersje newlib-nano przy linkowaniu), <strong>(b)</strong> <code>-ffast-math -funroll-loops</code> (główny zysk w INT), <strong>(c)</strong> prefetch flasha (<code>FLASH_ACR_PRFTEN</code>).</p>
          <p><strong>Uczciwość porównania.</strong> Prefetch włączono w kodzie wspólnym i Keil został z nim przebudowany i zmierzony ponownie — wynik identyczny co do ~0,001% (pętle mieszczą się w I-cache ART). Ta sama technika <code>fast_libc.c</code> dołączona do projektu Keila poprawiłaby i jego wynik — ale kompilator open-source już teraz robi to samo zadanie szybciej, mniejszym binarium i za darmo.</p>
          <p><strong>Weryfikacja.</strong> Każdy wariant flashowany na płytkę i sprawdzony: baner SWO (toolchain + wyniki DWT), animacja scrollującego tekstu na kamerze RTSP, ping i panel HTTP. Pomiar: <code>DWT→CYCCNT</code> @ 168 MHz, jednorazowo po starcie, sekcja krytyczna bez sieci.</p>
        </details>
      </div>
    </div>
  </section>

  <!-- 05 artykuł: agent -->
  <section class="sect sect--dark" aria-labelledby="agent">
    <div class="container">
      <SectHead eyebrow="05 / Puenta · Jak to zmierzono" title="Cały eksperyment wykonał agent AI — na prawdziwym sprzęcie." id="agent" small />
      <img class="hero-img rv" src="/img/sub/keil-vs-gcc-film.webp" alt="Laptop z terminalem agenta AI obok matrycy LED 64×64 wyświetlającej padający śnieg — kadr jak z filmu „Od promptu do pikseli"" width="1380" height="768" loading="lazy" />
      <div class="prose prose--inv rv">
        <p class="bm-lede">Cały eksperyment — dopisanie benchmarku do firmware, pięć kompilacji dwoma toolchainami, flashowanie, pomiary na sprzęcie i weryfikacja obrazu na fizycznym panelu LED — wykonał agent AI, sterując narzędziami z linii poleceń. Dokładnie ten sam zestaw i ta sama pętla, które widzisz w naszym filmie <strong>„Od promptu do pikseli"</strong>.</p>
        <h2>Keil z agentem: szybciej niż człowiek z Keilem</h2>
        <p>Agentowe programowanie embedded działa też na komercyjnym stacku. Keil ma CLI (<code>UV4.exe -r</code>), STM32CubeProgrammer flashuje i czyta SWO z konsoli — agent w pętli edytuje kod, buduje, wgrywa i czyta logi ITM szybciej, niż człowiek zdąży przeklikać się przez µVision. Każda iteracja „zmiana → build → flash → dowód w SWO" zamykała się w ~2 minuty, a numer buildu w banerze startowym dawał twardy dowód, że na płytce działa właściwy firmware.</p>
        <h2>Ale prawdziwa dźwignia to open source</h2>
        <p>Keil w tej pętli pozostaje wąskim gardłem: zamknięty kompilator bez wglądu w biblioteki, licencja per stanowisko, tylko Windows. Agent może go obsługiwać, ale nie może z nim <em>współpracować</em>. Z narzędziami open-source pętla domyka się w całości:</p>
        <ul>
          <li><strong>arm-none-eabi-gcc</strong> — kompilator, którego flagi, biblioteki i wygenerowany kod agent może inspekcjonować i stroić; efekt: firmware 3,75× szybszy i 2,4× mniejszy od Keila;</li>
          <li><strong>newlib / newlib-nano</strong> — gdy <code>memcpy</code> okazał się bajtowy, agent to <em>zobaczył</em> w źródle i napisał zamiennik, zamiast zgadywać, co robi czarna skrzynka;</li>
          <li><strong>GNU make + skrypty shell</strong> — build deterministyczny i tekstowy, idealny interfejs dla agenta (i dla CI);</li>
          <li><strong>OpenOCD + st-flash + GDB</strong> — flashowanie i pełny debug source-level bez licencji, na Windows, Linuksie i macOS;</li>
          <li><strong>DWT/ITM (SWO)</strong> — benchmark z tego raportu to 60 linii C i <code>printf</code> przez SWO, zero dodatkowego sprzętu;</li>
          <li><strong>ffmpeg + kamera RTSP</strong> — agent „patrzy" na fizyczny panel i sam potwierdza, że animacja scrolluje bez artefaktów;</li>
          <li><strong>git</strong> — każdy krok eksperymentu zapisany atomowym commitem: wynik odtwarzalny i audytowalny.</li>
        </ul>
        <blockquote class="bm-quote">Zamknięte IDE ogranicza agenta do roli klikacza. Otwarty toolchain robi z niego inżyniera: może przeczytać źródło biblioteki, zmierzyć skutek na sprzęcie i poprawić wynik — w jednej, samodzielnej pętli.</blockquote>
        <h2>Co z tego wynika</h2>
        <p>Po pierwsze: <strong>agent + dowolny toolchain z CLI</strong> bije ręczną pracę w IDE, bo iteracja jest tania i weryfikowalna. Po drugie: <strong>agent + open source</strong> bije agenta z narzędziami zamkniętymi, bo przewaga agenta rośnie z przezroczystością stosu. Po trzecie: koszt wejścia to zero złotych i jeden plik <code>build.sh</code> — cała reszta to sprzęt, który już leży na biurku.</p>
        <p class="bm-foot">Pomiar: 16.07.2026 · DWT→CYCCNT @ 168 MHz · Keil MDK 5.37 (ARMCC 5.06u7) · Arm GNU Toolchain 14.2.Rel1 · weryfikacja: SWO + kamera RTSP + HTTP</p>
      </div>
    </div>
  </section>

  <!-- 06 powiązane -->
  <section class="sect" aria-labelledby="powiazane">
    <div class="container">
      <SectHead eyebrow="06 / Czytaj dalej" title="Zrób to u siebie." id="powiazane" small />
      <div class="link-cards rv">
        <a class="link-card" href="/stm32-skill"><h3>Skill STM32 dla Claude Code</h3><p>Ten sam workflow build → flash → weryfikacja, spakowany do pobrania — z konfiguratorem pod Twoją płytkę.</p></a>
        <a class="link-card" href="/ai-dla-embedded"><h3>AI dla embedded</h3><p>Jak wdrażamy agentów AI w zespołach firmware i elektroniki.</p></a>
        <a class="link-card" href="/warsztat-embedded"><h3>Warsztat embedded</h3><p>Warsztat na żywym kodzie Twojego zespołu — z weryfikacją na prawdziwym sprzęcie.</p></a>
      </div>
    </div>
  </section>

  <CtaBand heading="Chcesz taką pętlę w swoim zespole embedded?" text="Wdrażamy agentów AI, które budują, wgrywają i weryfikują firmware na Waszym sprzęcie — z pomiarem zamiast obietnic. 30 minut wystarczy, żeby sprawdzić, czy ma to u Was sens." padTop={false} />

  <style>
    /* tokeny wykresów — serie w języku DS: Keil = niebieskie, GCC = neutral/zieleń, zwycięzca = akcent */
    .sect { --bm-keil: #3c56f4; --bm-keil2: #7c90f7; --bm-gcc0: #8b95a3; --bm-gcc2: #1f7a4d; --bm-tuned: var(--color-accent); }
    .sect--dark { --bm-gcc2: #34b47e; --bm-gcc0: #77808d; }
    .bm-card { background: var(--color-paper, #fff); border: 1px solid var(--color-line, rgba(0,0,0,.12)); border-radius: var(--radius-card, 14px); padding: var(--space-lg); margin: 0; }
    .sect--dark .bm-card { background: var(--color-ink-2); border-color: var(--color-line-dark); }
    .bm-scroll { overflow-x: auto; }
    .bm-grid { stroke: color-mix(in oklch, currentColor 12%, transparent); stroke-width: 1; }
    .bm-axis { stroke: color-mix(in oklch, currentColor 30%, transparent); stroke-width: 1.5; }
    .bm-tick { font: 12px var(--font-body, system-ui); fill: var(--color-text-2, #667); }
    .bm-lbl { font: 600 12.5px var(--font-body, system-ui); fill: var(--color-text, #1c1e22); }
    .bm-lbl--win { font-weight: 700; }
    .bm-ideal { font: 600 12.5px var(--font-body, system-ui); fill: var(--bm-gcc2); }
    .bm-halo { opacity: .45; animation: bm-pulse 2.4s ease-in-out infinite; transform-origin: 280px 304px; }
    @keyframes bm-pulse { 0%,100% { opacity: .45; transform: scale(1); } 50% { opacity: .15; transform: scale(1.35); } }
    @media (prefers-reduced-motion: reduce) { .bm-halo { animation: none; } }

    .bm-bars { display: grid; gap: 2px; }
    .bm-row { display: grid; grid-template-columns: minmax(130px, 190px) 1fr minmax(84px, auto); gap: var(--space-md); align-items: center; padding: .55rem .9rem; border-radius: var(--radius-btn, 8px); }
    .bm-row--win { background: color-mix(in oklch, var(--color-accent) 10%, transparent); outline: 1px solid color-mix(in oklch, var(--color-accent) 35%, transparent); }
    .bm-row__lbl { display: flex; align-items: center; gap: .55rem; font-size: var(--text-s); color: var(--color-text-inv, #eee); white-space: nowrap; }
    .bm-dot { flex: none; width: 10px; height: 10px; border-radius: 3px; display: inline-block; }
    .bm-track { display: flex; height: 20px; background: color-mix(in oklch, currentColor 10%, transparent); border-radius: 5px; overflow: hidden; gap: 2px; }
    .bm-seg { height: 100%; width: 0; transition: width 1.1s cubic-bezier(.22,.61,.36,1); }
    .bm-bars.is-in .bm-seg { width: var(--w); }
    .bm-val { font-variant-numeric: tabular-nums; font-weight: 600; font-size: var(--text-s); color: var(--color-text-inv, #eee); text-align: right; white-space: nowrap; }
    .bm-sublegend { margin: var(--space-sm) .9rem 0; font-size: var(--text-caption); color: var(--color-text-inv-3, #99a); }
    @media (prefers-reduced-motion: reduce) { .bm-seg { transition: none; } .bm-bars .bm-seg { width: var(--w); } }

    /* elementy siatek LED powstają w JS — bez atrybutu scope Astro, stąd :global */
    .bm-flash { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: var(--space-lg); }
    .bm-flash :global(.cap) { font-size: var(--text-caption); margin-bottom: .5rem; display: flex; align-items: center; gap: .5rem; color: var(--color-text-2); }
    .bm-flash :global(.cap b) { font-variant-numeric: tabular-nums; margin-left: auto; color: var(--color-text); }
    .bm-flash :global(.bm-dot) { flex: none; width: 10px; height: 10px; border-radius: 3px; display: inline-block; }
    .bm-flash :global(.bm-ledgrid) { display: grid; grid-template-columns: repeat(16, 1fr); gap: 3px; }
    .bm-flash :global(.bm-led) { aspect-ratio: 1; border-radius: 50%; background: color-mix(in oklch, currentColor 10%, transparent); }

    .bm-table { border-collapse: collapse; width: 100%; min-width: 760px; font-size: var(--text-s); }
    .bm-table th, .bm-table td { padding: .7rem .9rem; text-align: right; border-top: 1px solid var(--color-line, rgba(0,0,0,.1)); font-variant-numeric: tabular-nums; white-space: nowrap; }
    .bm-table th { font-size: var(--text-caption); letter-spacing: .06em; text-transform: uppercase; color: var(--color-text-2); border-top: none; }
    .bm-table th:first-child, .bm-table td:first-child { text-align: left; }
    .bm-table th .bm-dot { margin-right: .4rem; vertical-align: -1px; }
    .bm-table .bm-total td { font-weight: 650; background: color-mix(in oklch, currentColor 5%, transparent); }
    .bm-win { color: var(--bm-gcc2); font-weight: 650; }

    .prose--inv p, .prose--inv li { color: var(--color-text-inv-2); }
    .prose--inv strong, .prose--inv h2, .prose--inv h3 { color: var(--color-text-inv); }
    .prose--inv code { background: color-mix(in oklch, var(--color-text-inv) 12%, transparent); padding: 1px 5px; border-radius: 4px; font-size: .92em; }
    .prose code { background: color-mix(in oklch, currentColor 8%, transparent); padding: 1px 5px; border-radius: 4px; font-size: .92em; }
    .bm-details summary { cursor: pointer; font-weight: 600; }
    .bm-details[open] summary { margin-bottom: var(--space-sm); }
    .bm-lede { font-size: 1.08em; }
    .bm-quote { border-left: 3px solid var(--color-accent); padding: var(--space-sm) var(--space-lg); background: color-mix(in oklch, var(--color-accent) 8%, transparent); border-radius: 0 var(--radius-btn, 8px) var(--radius-btn, 8px) 0; font-weight: 500; }
    .bm-foot { font-size: var(--text-caption); color: var(--color-text-inv-2, #b9bec8); }
  </style>

  <script>
    // Mapa zajętości flasha — siatka bloków po 16 kB, generowana per wariant
    const variants = [
      { name: 'GCC −O0', v: '--bm-gcc0', kb: 584.2 },
      { name: 'Keil default', v: '--bm-keil', kb: 536.7 },
      { name: 'Keil −O2+split', v: '--bm-keil2', kb: 509.7 },
      { name: 'GCC −O2 tuned', v: '--bm-tuned', kb: 219.7 },
      { name: 'GCC −O2', v: '--bm-gcc2', kb: 210.2 },
    ];
    const host = document.getElementById('bm-flash');
    for (const va of variants) {
      const lit = Math.round(va.kb / 16);
      const cell = document.createElement('div');
      cell.innerHTML = `<div class="cap"><i class="bm-dot" style="background:var(${va.v})"></i>${va.name}<b>${va.kb.toFixed(0)} kB</b></div>`;
      const grid = document.createElement('div');
      grid.className = 'bm-ledgrid';
      for (let i = 0; i < 128; i++) {
        const d = document.createElement('div');
        d.className = 'bm-led';
        if (i < lit) d.style.background = `var(${va.v})`;
        grid.appendChild(d);
      }
      cell.appendChild(grid);
      host.appendChild(cell);
    }

    // Paski + liczniki startują, gdy sekcja wjedzie w viewport
    const bars = document.getElementById('bm-bars');
    bars.querySelectorAll('.bm-seg').forEach((s) => s.style.setProperty('--w', s.dataset.w + '%'));
    const counters = [...bars.querySelectorAll('.bm-val')];
    const runCount = (el) => {
      const target = +el.dataset.count;
      const strong = el.querySelector('strong');
      const t0 = performance.now();
      const tick = () => {
        const p = Math.min(1, (performance.now() - t0) / 1100);
        const v = Math.round(target * (1 - (1 - p) * (1 - p)));
        (strong || el).textContent = `${v} ms`;
        if (p < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };
    new IntersectionObserver((entries, obs) => {
      if (!entries.some((e) => e.isIntersecting)) return;
      bars.classList.add('is-in');
      counters.forEach(runCount);
      obs.disconnect();
    }, { threshold: 0.35 }).observe(bars);
  </script>
</Interior>
