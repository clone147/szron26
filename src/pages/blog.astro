---
import { getCollection } from 'astro:content';
import Interior from '../layouts/Interior.astro';
import SectHead from '../components/SectHead.astro';
import ProofStrip from '../components/ProofStrip.astro';
import CtaBand from '../components/CtaBand.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()
);
const MIESIACE_PL = ['stycznia','lutego','marca','kwietnia','maja','czerwca','lipca','sierpnia','września','października','listopada','grudnia'];
const fmt = (d) => `${d.getDate()} ${MIESIACE_PL[d.getMonth()]} ${d.getFullYear()}`;
const cats = [...new Set(posts.map((p) => p.data.category))];
const plural = (n, one, few, many) => (n === 1 ? one : n % 10 >= 2 && n % 10 <= 4 && (n % 100 < 12 || n % 100 > 14) ? few : many);
---
<Interior
  title="Blog — AI dla programistów | SZRON"
  description="Praktyczne wpisy o narzędziach AI do kodowania: Cursor, Claude Code, Copilot, MCP, wdrożenia w zespołach dev. Porównania i wnioski z prawdziwych projektów."
  eyebrow="Blog · AI dla programistów"
  heading="Blog SZRON. AI dla programistów, bez marketingu."
  lead="Praktyczne wpisy o narzędziach AI do kodowania — porównania, wdrożenia i wnioski z prawdziwych projektów. Piszemy to, co sami chcielibyśmy czytać."
>
  <!-- proof -->
  <ProofStrip items={[
    [`${posts.length} ${plural(posts.length, 'wpis', 'wpisy', 'wpisów')}`, 'porównania narzędzi i wnioski z wdrożeń'],
    [`${cats.length} ${plural(cats.length, 'kategoria', 'kategorie', 'kategorii')}`, cats.join(' · ')],
    [fmt(posts[0].data.publishedAt), 'ostatnia publikacja'],
  ]} />

  <!-- 01 wpisy -->
  <section class="sect" aria-labelledby="wpisy">
    <div class="container">
      <SectHead eyebrow={`01 / Wpisy · ${posts.length} tekstów`} title="Najnowsze wpisy." id="wpisy" small />
      <div class="link-cards rv" style="grid-template-columns:repeat(auto-fill,minmax(20rem,1fr))">
        {posts.map((p) => (
          <a class="link-card" href={`/blog/${p.id}`}>
            <p class="eyebrow" style="margin-bottom:.5rem">{p.data.category} · {fmt(p.data.publishedAt)}</p>
            <h3>{p.data.title}</h3>
            <p>{p.data.excerpt}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 02 więcej konkretu (ciemna) -->
  <section class="sect sect--dark" aria-labelledby="tymczasem">
    <div class="container">
      <SectHead eyebrow="02 / Więcej konkretu · Akademia i case studies" title="Blog to wycinek — reszta jest tutaj." id="tymczasem" />
      <div class="link-cards rv">
        <a class="link-card" href="/akademia">
          <h3>Akademia SZRON</h3>
          <p>Program szkoleń z programowania z agentami AI — od podstaw po Context Engineering i MCP.</p>
        </a>
        <a class="link-card" href="/case-studies">
          <h3>Case studies</h3>
          <p>Konkretne wdrożenia i ich efekty. Zobacz, jak AI zmienia pracę zespołów w prawdziwych projektach.</p>
        </a>
        <a class="link-card" href="/zasoby">
          <h3>Zasoby</h3>
          <p>Playbook, checklisty i samoocena dojrzałości AI — materiały do samodzielnej lektury na start.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- kontakt CTA -->
  <CtaBand
    eyebrow="Kontakt"
    heading="Masz temat, o którym chciałbyś przeczytać? Powiedz nam."
    text="Jeśli mierzysz się z konkretnym problemem przy AI w zespole, umów rozmowę. Odpowiemy wprost, a przy okazji podpowiemy, gdzie zacząć w Akademii."
    btnLabel="Zarezerwuj termin"
  />
</Interior>
